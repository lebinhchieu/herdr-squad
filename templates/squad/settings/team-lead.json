{
  "model": "sonnet",
  "effortLevel": "medium",
  "advisorModel": "opus",
  "permissions": {
    "allow": [
      "SendMessage", "ListAgents", "Bash(squad-process rule:*)", "Bash(squad-process who:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git branch:*)", "Bash(echo:*)", "Bash(squad-respawn:*)",
      "Bash(squad-spawn dev:*)", "Bash(squad-retire:*)", "Bash(herdr agent list:*)", "Bash(herdr agent get:*)", "Bash(herdr agent read:*)", "Bash(rm -rf /tmp/tmp.*)", "Bash(rm -r /tmp/tmp.*)", "Bash(rm /tmp/tmp.*)", "Bash(rmdir /tmp/tmp.*)"
    ],
    "deny": [
      "Bash(git push:*)", "Bash(git merge:*)", "Bash(git rebase:*)", "Bash(git reset --hard:*)", "Bash(git checkout main:*)", "Bash(git checkout dev:*)"
