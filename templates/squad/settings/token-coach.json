    "deny": [
      "Bash(git push:*)", "Bash(git merge:*)", "Bash(git rebase:*)", "Bash(git reset --hard:*)",
      "Write(/.claude/squads/*/*.md)", "Edit(/.claude/squads/*/*.md)",
      "Write(/.claude/squads/*/scopes/*/*.md)", "Edit(/.claude/squads/*/scopes/*/*.md)", "Write(/.claude/squads/*/goals/*/*.md)", "Edit(/.claude/squads/*/goals/*/*.md)", "Write(/.claude/squads/*/settings/**)", "Edit(/.claude/squads/*/settings/**)",
      "Read(~/.claude/projects/**)", "Read(~/.claude-2/projects/**)"
    ]
  }
}
