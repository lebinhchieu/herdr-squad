{
  "model": "sonnet",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "SendMessage", "ListAgents", "Bash(squad-usage:*)", "Bash(echo:*)", "Bash(git log:*)",
      "Write(/.claude/squads/*/scopes/*/iterations/*.coach.md)", "Edit(/.claude/squads/*/scopes/*/iterations/*.coach.md)",
      "Write(/.claude/squads/*/goals/*/coach/*.coach.md)", "Edit(/.claude/squads/*/goals/*/coach/*.coach.md)"
