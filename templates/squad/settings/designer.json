{
  "model": "sonnet",
  "effortLevel": "high",
  "advisorModel": "opus",
  "permissions": {
    "additionalDirectories": ["/tmp"],
    "allow": [
      "SendMessage",
      "ListAgents",
      "Bash(squad-respawn:*)", "Bash(squad-process rule:*)", "Bash(squad-process who:*)",
      "Bash(echo:*)",
      "Bash(git log:*)",
      "Write(/.claude/squads/*/scopes/*/ui-design/**)",
      "Edit(/.claude/squads/*/scopes/*/ui-design/**)",
      "Bash(rm -rf /tmp/*)",
      "Bash(rm -r /tmp/*)",
      "Bash(rm /tmp/*)",
      "Bash(rmdir /tmp/*)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Write(//tmp/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout main:*)",
      "Bash(git checkout dev:*)",
      "Bash(git branch -D:*)"
    ],
    "deny": [
      "Write(/.claude/squads/*/*.md)",
      "Edit(/.claude/squads/*/*.md)",
      "Write(/.claude/squads/*/scopes/*/*.md)",
      "Edit(/.claude/squads/*/scopes/*/*.md)",
      "Write(/.claude/squads/*/goals/*/*.md)",
      "Edit(/.claude/squads/*/goals/*/*.md)",
      "Write(/.claude/squads/*/settings/**)",
      "Edit(/.claude/squads/*/settings/**)"
    ]
  }
}
