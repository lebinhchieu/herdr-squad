#!/usr/bin/env python3
"""One review file per HANDIN: the task's AC, diff stat, hunks, test commands, evidence path (REV-15).

  squad-review-pack NN [--sha S] [--base REF] [--scope DIR] [--max-lines N]

Writes only $SCOPE_DIR/evidence/NN/pack.md and pack-blackbox.md (the blind copy: no code, no diff).
Run in the Developer's worktree. Exit 0 ok, 2 usage error.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    import squadreviewpack
    return squadreviewpack.run(argv)


if __name__ == "__main__":
    sys.exit(main())
