#!/usr/bin/env python3
"""Per-task state from messages.jsonl: last HANDIN, verdicts, returns, open BLOCKED, ASK rounds.

  squad-ledger [--home <dir>] [--task NN] [--json]

--home defaults to $SCOPE_DIR, else $GOAL_DIR, else $SQUAD_DIR. Exit 0 ok, 2 usage error.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    import squadledger
    return squadledger.run(argv)


if __name__ == "__main__":
    sys.exit(main())
