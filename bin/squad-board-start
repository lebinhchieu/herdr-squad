#!/usr/bin/env bash
# Make sure the board of this squad runs in a herdr tab labelled "board" and print its URL (one line, stdout).
set -euo pipefail

usage() {
  cat <<'EOF2'
Usage: squad-board-start [--squad S] [--restart]

Runs bin/squad-board in a herdr tab labelled "board" in the caller's workspace, unless one already runs
there, and prints its URL (it ends in the token). --restart closes the old tab and starts a new board.
Env: SQUAD_DIR (else the only squad in <git root>/.claude/squads, or --squad), HERDR_ENV=1, HERDR_WORKSPACE_ID.
EOF2
}

squad="" restart=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --squad) squad=${2:?--squad needs a name}; shift 2 ;;
    --restart) restart=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ ${HERDR_ENV:-} == 1 ]] || { echo "not inside a herdr pane (HERDR_ENV != 1)" >&2; exit 1; }
command -v python3 >/dev/null || { echo "python3 is required to run the board and was not found" >&2; exit 1; }

plugin_root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
if [[ -n ${SQUAD_DIR:-} ]]; then
  squad_dir=$(readlink -f "$SQUAD_DIR")
elif [[ -n $squad ]]; then
  squad_dir=$(readlink -f "$top/.claude/squads/$squad")
else
  found=("$top"/.claude/squads/*/process.md)
  [[ ${#found[@]} -eq 1 && -f ${found[0]} ]] || { echo "pick a squad with --squad (found ${#found[@]} in $top/.claude/squads)" >&2; exit 2; }
  squad_dir=$(dirname "$(readlink -f "${found[0]}")")
fi
[[ -f $squad_dir/process.md ]] || { echo "no squad folder at $squad_dir (run /squad:squad-init)" >&2; exit 1; }

# Without --workspace herdr uses the focused workspace, which may not be the caller's.
ws_args=()
[[ -z ${HERDR_WORKSPACE_ID:-} ]] || ws_args=(--workspace "$HERDR_WORKSPACE_ID")

url_re='squad-board: http://127\.0\.0\.1:[0-9]+/\?token=[A-Za-z0-9_-]+'

tab_id=$(herdr tab list "${ws_args[@]}" | jq -r '[.result.tabs[] | select(.label == "board")][0].tab_id // empty')
if [[ -n $tab_id && $restart == 1 ]]; then
  herdr tab close "$tab_id" >/dev/null
  tab_id=""
fi

if [[ -n $tab_id ]]; then
  pane=$(herdr pane list "${ws_args[@]}" | jq -r --arg t "$tab_id" '[.result.panes[] | select(.tab_id == $t)][0].pane_id // empty')
  [[ -n $pane ]] || { echo "the board tab $tab_id has no pane; run squad-board-start --restart" >&2; exit 1; }
else
  tab_json=$(herdr tab create --cwd "$top" --label board --no-focus "${ws_args[@]}")
  pane=$(jq -r '.result.root_pane.pane_id' <<<"$tab_json")
  herdr pane run "$pane" "SQUAD_DIR=$(printf %q "$squad_dir") $(printf %q "$plugin_root/bin/squad-board")" >/dev/null
fi

if ! herdr pane wait-output "$pane" --regex "$url_re" --timeout 10000 >/dev/null 2>&1; then
  echo "the board did not print its URL within 10 s; last lines of its tab:" >&2
  herdr pane read "$pane" --lines 20 >&2 || true
  exit 1
fi
herdr pane read "$pane" --lines 200 | grep -Eo "$url_re" | tail -n 1 | sed 's/^squad-board: //'
