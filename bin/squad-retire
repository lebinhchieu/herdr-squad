#!/usr/bin/env bash
# Ask a squad agent to save its notes, then close its herdr pane. Worktree and branch are kept.
set -euo pipefail

[[ $# -lt 1 || $1 == -h || $1 == --help ]] && { echo "Usage: squad-retire <agent-name> [--no-notes]"; exit 2; }
name=$1; notes=1
[[ ${2:-} == --no-notes ]] && notes=0

command -v jq >/dev/null || { echo "squad-retire needs jq: install it (Windows: winget install jqlang.jq)" >&2; exit 1; }

# A Team Lead retires every pod role except manager, token-coach and team-lead rows (its own too); a name missing from
# its roster is refused. The role comes from the roster row, lowercased with spaces to dashes.
if [[ ${SQUAD_ROLE:-} == team-lead ]]; then
  row=$("$(dirname "$(readlink -f "$0")")/squad-usage" --get "$name" 2>/dev/null) || row=""
  row_role=$(tr 'A-Z ' 'a-z-' <<<"${row%%$'\t'*}")
  case $row_role in
    ""|manager|token-coach|team-lead) echo "a Team Lead may not retire ${name} (${row_role:-no roster row}); it retires the pod roles and Developers only" >&2; exit 2 ;;
  esac
fi

# The pane, not the tab: the PO may have merged other agents into this tab, and closing a tab kills them all.
pane=$(herdr agent get "$name" | jq -r '.result.agent.pane_id // .result.pane_id // empty')
[[ -n $pane ]] || { echo "no live agent named $name" >&2; exit 1; }

if [[ $notes == 1 ]]; then
  herdr agent prompt "$name" "RETIRE: update your notes file roles/$name.notes.md (in \$SCOPE_DIR; \$GOAL_DIR for a goal Manager; \$SQUAD_DIR in a flat squad) with anything a successor needs, then reply DONE." \
    --wait --timeout 300000 >/dev/null || echo "warning: $name did not settle; closing anyway" >&2
fi

herdr pane close "$pane" >/dev/null
# The agent's scratch dir (SAFE-11) goes with it; a respawn closes the pane itself and keeps it. A failure only warns.
python3 "$(dirname "$(readlink -f "$0")")/squad-tmp" clean "$name" 2>/dev/null || echo "warning: could not delete the scratch dir of $name; going on" >&2
# Log the retire (a `fresh` with no later respawn or retire is otherwise unexplained). A log problem only warns.
home=${SCOPE_DIR:-${GOAL_DIR:-${SQUAD_DIR:-}}}
if [[ -d $home ]]; then
  IFS=$'\t' read -r row_role row_scope _ < <("$(dirname "$(readlink -f "$0")")/squad-usage" --get "$name" 2>/dev/null) || true
  "$(dirname "$(readlink -f "$0")")/squad-event" "$home" retire "$name" "${row_role:-}" "${row_scope:-}" 2>/dev/null \
    || echo "warning: could not write the retire event to $home/usage-events.jsonl; going on" >&2
fi
jq -n --arg name "$name" --arg pane "$pane" '{name:$name, pane:$pane, status:"retired"}'
