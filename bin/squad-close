#!/usr/bin/env bash
# Close finished work and tidy up after it. Branches are only reported, never deleted: merging and deleting
# them is the PO's call.
#
#   squad-close <squad> --scope S   per-scope squad: retire S's agents (its Manager last), remove worktrees whose
#                                   branch is merged and clean, move scopes/S to scopes/_done/S.
#                                   flat squad (legacy): retire the agents whose Scope column is S and drop their
#                                   roster rows; the squad stays.
#   squad-close <squad> --goal G    retire the goal Manager, move goals/G to goals/_done/G. Refuses while a scope of
#                                   G is still open, or while shared/decisions.md has entries and goal.md has no
#                                   `promoted:` line yet (the goal's knowledge would be lost). --force overrides.
#   squad-close <squad>             retire every agent, remove merged worktrees, archive the squad folder to
#                                   .claude/squads/_done/<squad>/ (evidence included).
set -euo pipefail

usage() { echo "Usage: squad-close <squad> [--scope S | --goal G] [--into BRANCH] [--force] [--dry-run]"; }
[[ $# -lt 1 || $1 == -h || $1 == --help ]] && { usage; exit 2; }
squad=$1; shift
scope="" goal="" into="" force=0 dry=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --scope) scope=$2; shift 2 ;;
    --goal) goal=$2; shift 2 ;;
    --into) into=$2; shift 2 ;;
    --force) force=1; shift ;;
    --dry-run) dry=1; shift ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ -z $scope || -z $goal ]] || { echo "pass --scope or --goal, not both" >&2; exit 2; }

bin=$(dirname "$(readlink -f "$0")")
if [[ -n ${SQUAD_DIR:-} && $(basename "$SQUAD_DIR") == "$squad" ]]; then
  squad_dir=$SQUAD_DIR
else
  squad_dir=$(git rev-parse --show-toplevel)/.claude/squads/$squad
fi
[[ -f $squad_dir/process.md ]] || { echo "no squad folder at $squad_dir" >&2; exit 1; }
squad_dir=$(readlink -f "$squad_dir")
squads_root=$(dirname "$squad_dir")
project_dir=$(dirname "$(dirname "$squads_root")")
wt_root=$project_dir/.worktrees/$squad
layout=flat; [[ -d $squad_dir/scopes ]] && layout=scoped

# What this run closes: the roster files to read, the folder to archive, the worktrees to tidy.
rosters=() src="" dst="" mode=squad wts=()
if [[ -n $goal ]]; then
  [[ $layout == scoped ]] || { echo "--goal needs a per-scope squad" >&2; exit 1; }
  mode=goal src=$squad_dir/goals/$goal dst=$squad_dir/goals/_done/$goal
  [[ -d $src ]] || { echo "no goal folder at $src" >&2; exit 1; }
  rosters=("$src/roster.md")
elif [[ -n $scope && $layout == scoped ]]; then
  mode=scope src=$squad_dir/scopes/$scope dst=$squad_dir/scopes/_done/$scope
  [[ -d $src ]] || { echo "no scope folder at $src" >&2; exit 1; }
  rosters=("$src/roster.md")
elif [[ -n $scope ]]; then
  mode=label   # flat squad: Scope is only a column in roster.md
  rosters=("$squad_dir/roster.md")
else
  dst=$squads_root/_done/$squad
  rosters=("$squad_dir/roster.md")
  if [[ $layout == scoped ]]; then
    rosters+=("$squad_dir"/scopes/*/roster.md "$squad_dir"/goals/*/roster.md)
  fi
fi
# Checked first so a refusal leaves everything running.
[[ -z $dst || ! -e $dst ]] || { echo "$dst already exists; move it away first" >&2; exit 1; }

unpromoted() {  # goal folder $1 has shared decisions that were never promoted to the project docs
  [[ -f $1/shared/decisions.md ]] && grep -q '^- ' "$1/shared/decisions.md" && ! grep -q '^promoted:' "$1/goal.md" 2>/dev/null
}
if [[ $mode == goal && $force == 0 ]]; then
  open=$(grep -lE "^goal:[[:space:]]*$goal[[:space:]]*$" "$squad_dir"/scopes/*/scope.md 2>/dev/null | xargs -r -n1 dirname | xargs -r -n1 basename | xargs || true)
  [[ -z $open ]] || { echo "goal $goal still has open scopes: $open (close them first, or --force)" >&2; exit 1; }
  ! unpromoted "$src" || { echo "goal $goal has unpromoted decisions in shared/decisions.md and no 'promoted:' line in goal.md (promote first, or --force)" >&2; exit 1; }
fi

agents=() roles=() labels=()
for r in "${rosters[@]}"; do
  [[ -f $r ]] || continue
  while read -r a ro la; do agents+=("$a"); roles+=("$ro"); labels+=("$la"); done < \
    <(awk -F'|' '/^\|/ { n++; if (n > 2) { for (i = 2; i <= 4; i++) gsub(/ /, "", $i); print $2, tolower($3), $4 } }' "$r")
done
others=() managers=()
for i in "${!agents[@]}"; do
  if [[ ${roles[i]} == manager ]]; then
    [[ $mode == label ]] || managers+=("${agents[i]}")
  elif [[ $mode != label || ${labels[i]} == "$scope" ]]; then
    others+=("${agents[i]}")
  fi
done
[[ $mode != label || ${#others[@]} -gt 0 ]] || { echo "no agents with scope $scope in roster.md" >&2; exit 1; }

# Worktrees to tidy, newest layout first; the older flat layouts (squad-board) are found by agent name.
add_wt() { [[ -d $1 ]] && wts+=("$1") || true; }
case $mode in
  squad)
    if [[ -d $wt_root ]]; then
      while read -r d; do wts+=("$d"); done < <(find "$wt_root" -maxdepth 3 -name .git -printf '%h\n' | sort)
    fi
    for a in "${agents[@]}"; do add_wt "$project_dir/.worktrees/$a"; done ;;
  scope)
    if [[ -d $wt_root/$scope ]]; then
      while read -r d; do wts+=("$d"); done < <(find "$wt_root/$scope" -maxdepth 2 -name .git -printf '%h\n' | sort)
    fi ;;
  label)
    for a in "${others[@]}"; do
      if [[ -d $wt_root/$a ]]; then add_wt "$wt_root/$a"; else add_wt "$project_dir/.worktrees/$a"; fi
    done ;;
esac

retire() {
  for a in "$@"; do
    if [[ $dry == 1 ]]; then echo "would retire $a"
    else "$bin/squad-retire" "$a" --no-notes >/dev/null 2>&1 && echo "retired $a" || echo "skipped $a (not live)"; fi
  done
}

echo "== agents"
retire "${others[@]}"

if [[ $mode != goal ]]; then
  echo "== branches"
  for wt in "${wts[@]}"; do
    branch=$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || echo "squad/$squad/$(basename "$wt")")
    repo=$(dirname "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)")
    target=${into:-$(git -C "$repo" symbolic-ref --short HEAD)}
    if ! git -C "$repo" merge-base --is-ancestor "$branch" "$target"; then
      echo "$branch: NOT merged into $target, kept"
    elif [[ $dry == 1 ]]; then
      echo "$branch: merged into $target, would remove worktree"
    elif git -C "$repo" worktree remove "$wt" 2>/dev/null; then
      echo "$branch: merged into $target, worktree removed"
    else
      echo "$branch: merged into $target, kept (uncommitted changes)"
    fi
  done
  if [[ $dry == 0 && -d $wt_root ]]; then
    [[ $mode == scope ]] && rmdir "$wt_root/$scope" 2>/dev/null || true
    rmdir "$wt_root" 2>/dev/null || true
  fi
fi

if [[ $mode == squad && $layout == scoped ]]; then
  for g in "$squad_dir"/goals/*/; do
    [[ -d $g ]] || continue
    [[ $(basename "$g") == _done ]] || ! unpromoted "${g%/}" || echo "WARNING: goal $(basename "$g") has unpromoted decisions in shared/decisions.md"
  done
fi

if [[ $mode == label ]]; then
  echo "== roster"
  if [[ $dry == 1 ]]; then
    echo "would drop ${#others[@]} rows of scope $scope"
  else
    tmp=$(mktemp)
    awk -F'|' -v names=" ${others[*]} " '/^\|/ { n++; if (n > 2) { a = $2; gsub(/ /, "", a); if (index(names, " " a " ")) next } } { print }' \
      "$squad_dir/roster.md" >"$tmp"
    cat "$tmp" >"$squad_dir/roster.md"; rm "$tmp"  # keeps the file mode
    echo "dropped ${#others[@]} rows of scope $scope"
  fi
  exit 0
fi

echo "== folder"
from=${src:-$squad_dir}
if [[ $dry == 1 ]]; then
  echo "would move $from to $dst"
else
  mkdir -p "$(dirname "$dst")"
  mv "$from" "$dst"
  echo "archived to $dst"
fi

# Last, because the caller may be the Manager: closing its tab ends this script.
echo "== manager"
retire "${managers[@]}"
