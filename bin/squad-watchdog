#!/usr/bin/env python3
"""Plugin watchdog of one scope or goal: logs each idle start, nudges the Manager, and (only when asked) sleeps the PC.

  squad-watchdog run --home DIR --manager NAME [--interval S]   loop until DIR is gone (squad-start starts it)
  squad-watchdog tick --home DIR --manager NAME [--now UTC]     one pass (what `run` does every interval)
  squad-watchdog sleep on|off [--home DIR]                      the opt-in switch for sleep-when-done (off by default)
  squad-watchdog status [--home DIR]                            print the switch, the last state and the log tail

Idle = no live agent of the scope (or of the goal's scopes) is `working` in herdr while a ticket waits (ready, building,
returned, handed in, checking). The start of an idle spell is logged with every agent's state. After 5 and after 15 minutes
of the same spell the Manager gets a message (`herdr agent prompt`). The spell ends when someone works or no ticket waits.

Sleep-when-done is OFF. `squad-watchdog sleep on` turns it on; the Manager runs that only when the PO asks. While it is on,
the watchdog suspends the computer once, when for SQUAD_WATCHDOG_SLEEP_AFTER minutes (default 5) every ticket of the home
(for a goal: of its scopes) is done and no agent anywhere on this machine is `working` in herdr (the whole `herdr agent
list`: other squads run here too). It logs `sleep pc`, switches itself off (one shot: a wake-up does not sleep again), then
runs the suspend command. Nothing is retired. Suspend command by host: WSL powershell SetSuspendState, Linux `systemctl
suspend`, macOS `pmset sleepnow`, Windows `rundll32.exe powrprof.dll,SetSuspendState 0,1,0`; SQUAD_WATCHDOG_SLEEP_CMD
(a shell command) replaces it (tests use it).

Files in <home>: watchdog.log (one line per event, UTC), watchdog.state.json (state and heartbeat), watchdog.sleep (`on`).
Env: SQUAD_WATCHDOG_INTERVAL (seconds between passes, default 60), SQUAD_WATCHDOG_SLEEP_AFTER, SQUAD_WATCHDOG_SLEEP_CMD,
SQUAD_DIR / SCOPE_DIR / GOAL_DIR (default --home).
"""
import argparse
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

PLUGIN = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN / "bin"))
import squadio  # noqa: E402
import squadboard_active as active  # noqa: E402
import squadboard_agents as agents_mod  # noqa: E402
import squadreport  # noqa: E402
import squadtickets  # noqa: E402

NUDGES = (5, 15)            # minutes of an idle spell
SLEEP_AFTER_MIN = 5         # minutes everything must be done and quiet before the PC sleeps
INTERVAL_S = 60
OPEN = {"ready", "building", "returned", "handed in", "checking", "in progress"}
DONE = {"done", "resolved", "merged"}
RETIRED = {"retired", "closed"}
WSL_PS = ("Add-Type -AssemblyName System.Windows.Forms; "
          "[System.Windows.Forms.Application]::SetSuspendState('Suspend',$false,$false)")
LOG, STATE, SLEEP = "watchdog.log", "watchdog.state.json", "watchdog.sleep"


def iso(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def hhmm(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%H:%M UTC")


def read_state(home):
    try:
        o = json.loads((home / STATE).read_text(encoding="utf-8"))
        return o if isinstance(o, dict) else {}
    except (OSError, ValueError):
        return {}


def write_state(home, st):
    tmp = home / (STATE + ".tmp")
    with open(tmp, "w", encoding="utf-8", newline="\n") as fh:
        json.dump(st, fh)
    os.replace(tmp, home / STATE)


def log(home, now, text):
    with open(home / LOG, "a", encoding="utf-8", newline="\n") as fh:
        fh.write(f"{iso(now)} {text}\n")


def sleep_on(home):
    """The opt-in switch: <home>/watchdog.sleep holds a line `on`. No file = off."""
    try:
        lines = (home / SLEEP).read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    return any(l.split("#")[0].strip().lower() == "on" for l in lines)


def set_sleep(home, on):
    with open(home / SLEEP, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("# sleep-when-done switch (the PO asked for it); `on` or `off`\n" + ("on\n" if on else "off\n"))


def sleep_after_s():
    try:
        return float(os.environ.get("SQUAD_WATCHDOG_SLEEP_AFTER") or SLEEP_AFTER_MIN) * 60
    except ValueError:
        return SLEEP_AFTER_MIN * 60


def scope_homes(home):
    """[(label, folder)]: the home itself, and for a goal the scopes that name it."""
    out = [(home.name, home)]
    squad = home.parent.parent
    if home.parent.name == "goals":
        for sc in sorted((squad / "scopes").glob("*/scope.md")):
            if squadreport._scope_field(sc, "goal") == home.name:
                out.append((sc.parent.name, sc.parent))
    return out


def snapshot(home, herdr_json=None):
    """{ok, why, machine_working, agents: [{name, role, scope, owns, state}], tickets: [{scope, id, status}]}. state:
    working | idle | blocked | unknown (herdr gave a word we do not know) | gone (not in herdr) | retired (roster says so).
    One agent per name. machine_working: any agent of the whole herdr list (not only this squad) is working."""
    got, why = agents_mod.fetch({"herdr_json": herdr_json} if herdr_json else {})
    agents, tickets, seen = [], [], {}
    names = set()
    for label, h in scope_homes(home):
        for r in active.roster_rows(h):
            if r["name"] in names:
                continue  # a roster may list a name twice
            names.add(r["name"])
            if r["status"].lower() in RETIRED:
                state = "retired"
            elif got is None:
                state = "unknown"
            else:
                state = got[r["name"]]["status"] if r["name"] in got else "gone"
            agents.append({"name": r["name"], "role": r["role"], "scope": label, "owns": r["owns"], "state": state})
        for t in squadtickets.scope_tasks(h)["tasks"]:
            key = t.get("where") or (label, t["id"])  # scopes of a goal may share one ticket folder: one row per file
            if key in seen:
                seen[key]["scopes"].append(label)
            else:
                seen[key] = {"scope": label, "scopes": [label], "id": t["id"], "status": t["status"]}
                tickets.append(seen[key])
    machine = got is not None and any(i["status"] == "working" for i in got.values())
    return {"ok": got is not None, "why": why, "machine_working": machine, "agents": agents, "tickets": tickets}


def waiting(snap):
    return [t for t in snap["tickets"] if t["status"] in OPEN]


def states_text(snap):
    return ", ".join(f"{a['name']} {a['state']}" for a in snap["agents"]) or "no agent in the roster"


def tickets_text(snap):
    return ", ".join(f"{t['id']} {t['status']}" + (f" ({t['scope']})" if len({x['scope'] for x in snap['tickets']}) > 1 else "")
                     for t in waiting(snap))


def nudge_text(minutes, since, snap):
    first = minutes == NUDGES[0]
    head = (f"WATCHDOG: nobody has worked for {minutes} minutes (since {hhmm(since)}) and work is waiting."
            if first else f"WATCHDOG: still nobody working after {minutes} minutes (since {hhmm(since)}). This is the last reminder of this idle period.")
    return (f"{head} Waiting: {tickets_text(snap)}. Agents: {states_text(snap)}. "
            "Message the agent who owns a ticket, or spawn one. If you only wait for the PO's answer, or a test run is going, you can ignore this.")


def all_done(snap):
    return bool(snap["tickets"]) and all(t["status"] in DONE for t in snap["tickets"])


def decide(st, snap, now, sleep_enabled, sleep_after=SLEEP_AFTER_MIN * 60):
    """Pure: (old state, snapshot, now, switch on?, seconds) -> (new state, [event]).
    event = ("start", since) | ("nudge", minutes, since) | ("end", minutes) | ("sleep", minutes) | ("down", why) | ("up",)"""
    st = dict(st)
    events = []
    if not snap["ok"]:
        if not st.get("down"):
            events.append(("down", snap["why"]))
        st["down"] = True
        st["quiet_since"] = None  # a gap in the view: the quiet timer restarts when herdr is back
        return st, events
    if st.pop("down", False):
        events.append(("up",))
    working = any(a["state"] == "working" for a in snap["agents"])
    idle = not working and bool(waiting(snap))
    since = st.get("idle_since")
    if idle and since is None:
        since = st["idle_since"] = now
        st["nudged"] = []
        events.append(("start", since))
    elif not idle and since is not None:
        events.append(("end", int((now - since) // 60)))
        st["idle_since"], st["nudged"] = None, []
        since = None
    if since is not None:
        for m in NUDGES:
            if m not in st["nudged"] and now - since >= m * 60:
                st["nudged"] = st["nudged"] + [m]
                events.append(("nudge", m, since))
    # sleep-when-done: all tickets done and nobody on the machine working, for sleep_after seconds, switch on
    if all_done(snap) and not snap["machine_working"]:
        quiet = st["quiet_since"] = st.get("quiet_since") if st.get("quiet_since") is not None else now
        if sleep_enabled and now - quiet >= sleep_after:
            events.append(("sleep", int((now - quiet) // 60)))
            st["quiet_since"] = None
    else:
        st["quiet_since"] = None
    return st, events


def send(manager, text):
    """-> (ok, reason)."""
    try:
        r = subprocess.run(["herdr", "agent", "prompt", manager, text], capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        return False, str(e)
    return r.returncode == 0, (r.stderr.strip().splitlines() or ["herdr refused"])[-1] if r.returncode else ""


def suspend_cmd():
    """-> (argv or shell string, shell?). SQUAD_WATCHDOG_SLEEP_CMD wins; otherwise by host."""
    env = os.environ.get("SQUAD_WATCHDOG_SLEEP_CMD")
    if env:
        return env, True
    if sys.platform == "win32":
        return ["rundll32.exe", "powrprof.dll,SetSuspendState 0,1,0"], False
    if sys.platform == "darwin":
        return ["pmset", "sleepnow"], False
    try:
        wsl = os.environ.get("WSL_DISTRO_NAME") or "microsoft" in Path("/proc/version").read_text(encoding="utf-8", errors="replace").lower()
    except OSError:
        wsl = False
    if wsl:
        return ["powershell.exe", "-NoProfile", "-Command", WSL_PS], False
    return ["systemctl", "suspend"], False


def suspend():
    """-> (ok, reason): put the computer to sleep. Returns when it wakes up."""
    cmd, shell = suspend_cmd()
    try:
        r = subprocess.run(cmd, shell=shell, capture_output=True, text=True, encoding="utf-8", errors="replace")  # no timeout: a suspend returns after the wake-up
    except (OSError, subprocess.SubprocessError) as e:
        return False, str(e)
    return r.returncode == 0, (r.stderr.strip().splitlines() or ["suspend command failed"])[-1] if r.returncode else ""


def tick(home, manager, now=None, herdr_json=None, send=send, suspend_fn=None):
    """One pass: read, decide, act, log, save. Returns the events."""
    now = time.time() if now is None else now
    snap = snapshot(home, herdr_json)
    st, events = decide(read_state(home), snap, now, sleep_on(home), sleep_after_s())
    for ev in events:
        kind = ev[0]
        if kind == "start":
            log(home, now, f"idle start: nobody works and work waits ({tickets_text(snap)}). Agents: {states_text(snap)}")
        elif kind == "nudge":
            text = nudge_text(ev[1], ev[2], snap)
            ok, why = send(manager, text)
            log(home, now, f"nudge {ev[1]} min to {manager}: " + ("sent: " if ok else f"NOT sent ({why}): ") + text)
        elif kind == "end":
            log(home, now, f"idle end after {ev[1]} min. Agents: {states_text(snap)}")
        elif kind == "down":
            log(home, now, f"herdr does not answer ({ev[1]}); no idle check until it does")
        elif kind == "up":
            log(home, now, "herdr answers again")
        elif kind == "sleep":
            log(home, now, f"sleep pc: every ticket is done and nobody on this machine has worked for {ev[1]} min (the PO asked for sleep-when-done); "
                           "the switch goes off, then the computer suspends")
            set_sleep(home, False)  # one shot: a wake-up does not sleep again
            st["beat"], st["pid"] = now, os.getpid()
            write_state(home, st)  # before the suspend call, which returns only after the wake-up
            ok, why = (suspend_fn or suspend)()
            if not ok:
                log(home, time.time(), f"suspend failed ({why})")
    st["beat"], st["pid"] = now, os.getpid()
    write_state(home, st)
    return events


def run(home, manager, interval, herdr_json=None):
    st = read_state(home)
    if st.get("beat") and time.time() - st["beat"] < 3 * interval:
        return 0  # another watchdog of this home is alive
    log(home, time.time(), f"watchdog started for {home.name}; Manager {manager}; every {interval} s")
    while home.is_dir():
        try:
            tick(home, manager, herdr_json=herdr_json)
        except Exception as e:  # a watchdog that dies is the thing it exists to prevent
            try:
                log(home, time.time(), f"pass failed: {type(e).__name__}: {e}")
            except OSError:
                pass
        time.sleep(interval)
    return 0


def home_arg(a):
    h = a.home or os.environ.get("SCOPE_DIR") or os.environ.get("GOAL_DIR")
    if not h or not Path(h).is_dir():
        print("give --home DIR (the scope or goal folder), or run inside an agent with SCOPE_DIR or GOAL_DIR set", file=sys.stderr)
        sys.exit(2)
    return Path(h).resolve()


def default_manager(home):
    return f"{home.parent.parent.name}-mgr-{home.name}"


def main():
    squadio.utf8_stdio()
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("run", "tick"):
        s = sub.add_parser(name)
        s.add_argument("--home")
        s.add_argument("--manager")
        s.add_argument("--herdr-json", help="read herdr agents from a recorded file (tests)")
        s.add_argument("--now", help="act as if it were this UTC time, e.g. 2027-01-15T08:05:00Z (tests, demos)")
        if name == "run":
            s.add_argument("--interval", type=float, default=float(os.environ.get("SQUAD_WATCHDOG_INTERVAL") or INTERVAL_S))
    s = sub.add_parser("sleep")
    s.add_argument("switch", choices=("on", "off"))
    s.add_argument("--home")
    s = sub.add_parser("status")
    s.add_argument("--home")
    a = p.parse_args()
    home = home_arg(a)
    if a.cmd in ("run", "tick"):
        manager = a.manager or default_manager(home)
        if a.cmd == "run":
            return run(home, manager, a.interval, a.herdr_json)
        now = datetime.strptime(a.now, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp() if a.now else None
        tick(home, manager, now=now, herdr_json=a.herdr_json)  # the log is the output
        return 0
    if a.cmd == "sleep":
        set_sleep(home, a.switch == "on")
        print(f"sleep-when-done: {a.switch.upper() if a.switch == 'on' else 'off'}"
              + ("; the PC suspends once, when every ticket is done and nobody on this machine works for "
                 f"{sleep_after_s() / 60:g} min" if a.switch == "on" else ""))
        return 0
    st = read_state(home)
    beat = st.get("beat")
    print(f"last pass: {iso(beat) if beat else 'never'}; idle since: {iso(st['idle_since']) if st.get('idle_since') else '-'}; "
          f"sleep-when-done: {'ON' if sleep_on(home) else 'off'}")
    try:
        print("".join((home / LOG).read_text(encoding="utf-8").splitlines(True)[-10:]), end="")
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
