#!/usr/bin/env python3
"""Time and cost report of a scope or goal, from transcripts and logs. No LLM, no network.

  squad-report [<scope>|<goal>] [--squad S] [--out DIR] [--no-html] [--quiet] [--final] [--redact] [--deadline N]
  squad-report status <scope>        fresh | stale | missing  (exit 0 | 3 | 4)
  squad-report rollup <data.json>... [--out DIR]
  squad-report query <scope> <what> [--task X] [--role R] [--top N] [--refresh]

Exit 0 ok, 1 error, 2 refused, 3 stale, 4 missing, 5 deadline.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "rollup":
        import squadreport_rollup
        return squadreport_rollup.run(argv[1:])
    if argv and argv[0] == "query":
        import squadreport_query
        return squadreport_query.run(argv[1:])
    import squadreport_build
    if argv and argv[0] == "status":
        return squadreport_build.status(argv[1:])
    return squadreport_build.run(argv)


if __name__ == "__main__":
    sys.exit(main())
