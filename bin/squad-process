#!/usr/bin/env python3
"""Squad process version tool.

  squad-process version [--json]        squad version, plugin version, state, stamp
  squad-process check [--quiet] [--json]  one-line warning when the squad's process.md is not current

  squad-process lint [--squad-dir D] [--plugin-root R] [--cards error|warn] [--hashes]
                                        check the rule files (templates/squad/process/) and the squad's process.local.md

  squad-process compose <role> --home D [--agent A] [--out F] [--plugin-root R] [--squad-dir D]
                                        composed rules for one role (the <role> --home form)
  squad-process team --home D [--has ROLE]
                                        the scope's team (comma list, `none`, `undecided`); --has ROLE exits 0 (on it) / 1
  squad-process upgrade --check | --apply [--resolve ID=choice ...] [--yes] [--squad-dir D] [--plugin-root R]
                                        composed squads: move the overlay to the running plugin one rule at a time
                                        (exit 0 nothing to decide, 3 a decision is needed, 2 refused)
  squad-process upstream [--squad-dir D] the overlay's `upstream: proposed` operations, ready for a plugin ticket
  squad-process mode --squad-dir D       composed | legacy | none
  squad-process runtime --squad-dir D --home H [--dry-run]
                                        materialise and print the home's pinned plugin runtime
  squad-process prune --squad-dir D (--home H | --all) [--dry-run] [--protect PATH ...]
                                        delete the pinned runtimes no open scope, goal or plugin.pin holds

  squad-process adopt --squad-dir D [--dry-run] [--resolve KEY=CHOICE ...] [--yes]
                                        v6 squad -> composed: overlay, plugin.pin, local settings, open scopes pinned
                                        (exit 3: a PO item is open or --yes is missing; nothing written)
  squad-process scaffold --squad-dir D [--code-path P ...]
                                        new squad: process.local.md, plugin.pin, settings/*.local.json, project.md

  Legacy squads (a process.md that has not adopted yet):
  squad-process plan [--json]            read-only: changelog items, section states, conflicts
  squad-process compose --out FILE [--resolve "<heading>=ours|theirs|file:<path>" ...]
  squad-process apply --legacy --file FILE [--yes] without --yes: diff, "NOT APPLIED"; with it: backup, write, log

version and check take --squad-dir D (default $SQUAD_DIR) and --plugin-root R. Exit 0 always for these two:
a bad file is reported, never a failure of the caller. plan, compose and apply exit 2 when they refuse.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402
import squadprocess as sp  # noqa: E402


def _resolutions(args, conflicts):
    """["## H=ours", ...] -> {heading: how}; the heading is matched against the known conflicts, so '=' in it is fine."""
    out = {}
    for arg in args:
        for h in conflicts:
            if arg.startswith(h + "="):
                out[h] = arg[len(h) + 1:]
                break
        else:
            raise sp.ProcessError(f"--resolve {arg!r}: not '<conflict heading>=ours|theirs|file:<path>'")
    return out


def _mutating(a):
    if not a.squad_dir:
        print("squad-process: no --squad-dir and $SQUAD_DIR is not set", file=sys.stderr)
        return 2
    try:
        if a.cmd == "plan":
            pl = sp.plan(a.squad_dir, a.plugin_root)
            print(json.dumps(pl, indent=1) if a.json else sp.format_plan(pl))
        elif a.cmd == "compose":
            pl = sp.plan(a.squad_dir, a.plugin_root)
            conflicts = [r["heading"] for r in pl["sections"] if r["state"] == "conflict"]
            sp.compose(a.squad_dir, a.plugin_root, a.out, _resolutions(a.resolve, conflicts))
            print(f"composed {a.out}; check it with: squad-process apply --file {a.out}")
        else:
            if not a.legacy:
                raise sp.ProcessError("apply is the legacy v6 merge; add --legacy for a squad that has not adopted "
                                      "(`squad-process adopt` moves it to the composed layout)")
            r = sp.apply(a.squad_dir, a.plugin_root, a.file, a.yes)
            if "diff" in r:
                print(r["diff"].rstrip("\n"))
                print("changed sections: " + ("; ".join(r["changed"]) or "none"))
                for w in r["warnings"]:
                    print(w)
            if r.get("backup"):
                print(f"backup: {r['backup']}")
                print("log rows:\n" + "\n".join(r["log_rows"]))
            print(r["message"])
    except sp.ProcessError as e:
        print(f"squad-process: {e}", file=sys.stderr)
        return 2
    return 0


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("mode", "runtime", "prune"):
        import squadruntime  # squad mode and the pinned runtime: ticket 05
        return squadruntime.main(argv)
    if argv and argv[0] in ("adopt", "scaffold"):
        import squadadopt  # composed squads from old ones, and new ones: ticket 09
        return squadadopt.main(argv)
    if argv and argv[0] in ("upgrade", "upstream"):
        import squadupgrade  # upgrade one rule at a time: ticket 07
        return squadupgrade.main(argv)
    if argv and (argv[0] in ("lint", "rule", "who", "team")
                 or (argv[0] == "compose" and len(argv) > 1 and not argv[1].startswith("-"))):
        import squadrules_cli  # rule files: ticket 02; compose <role> is ticket 04
        return squadrules_cli.main(argv)
    ap = argparse.ArgumentParser(prog="squad-process", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("version", "check"):
        p = sub.add_parser(name)
        p.add_argument("--squad-dir", default=os.environ.get("SQUAD_DIR"))
        p.add_argument("--plugin-root", default=str(sp.DEFAULT_PLUGIN_ROOT))
        p.add_argument("--json", action="store_true")
        if name == "check":
            p.add_argument("--quiet", action="store_true", help="print nothing when current and stamped")
    pl = sub.add_parser("plan")
    co = sub.add_parser(
        "compose", usage="squad-process compose --out FILE [--resolve ...] | compose <role> --home D [--agent A] [--out F]",
        description="Without a role: the v6 process.md merge (--out FILE). With a role: `squad-process compose <role> "
        "--home D [--agent A] [--out F] [--plugin-root R] [--squad-dir D] [--now ISO]` composes that role's rules.")
    ap_ = sub.add_parser("apply")
    for p in (pl, co, ap_):
        p.add_argument("--squad-dir", default=os.environ.get("SQUAD_DIR"))
        p.add_argument("--plugin-root", default=str(sp.DEFAULT_PLUGIN_ROOT))
    pl.add_argument("--json", action="store_true")
    co.add_argument("--out", required=True)
    co.add_argument("--resolve", action="append", default=[])
    ap_.add_argument("--file", required=True)
    ap_.add_argument("--legacy", action="store_true", help="required: apply is the v6 merge for a squad that has not adopted")
    ap_.add_argument("--yes", action="store_true")
    a = ap.parse_args(argv)
    if a.cmd in ("version", "check") and a.squad_dir:
        import squadruntime
        if squadruntime.mode(a.squad_dir) == "composed":  # rules come from the plugin pin: no process.md to check
            if a.json:
                print(json.dumps({"state": "composed", "message": ""}))
            elif a.cmd == "version" or not a.quiet:
                print("composed squad: rules come from the plugin pin; nothing to check.")
            return 0
    if a.cmd in ("plan", "compose", "apply"):
        return _mutating(a)
    if not a.squad_dir:
        print("squad-process: no --squad-dir and $SQUAD_DIR is not set", file=sys.stderr)
        return 0
    try:
        r = sp.check(a.squad_dir, a.plugin_root)
    except sp.ProcessError as e:
        print(f"squad-process: {e}", file=sys.stderr)
        if a.cmd == "version":  # the squad half is still known
            try:
                n, stamp = sp.squad_version(a.squad_dir)
                print(f"squad {n} ({stamp}), plugin unknown")
            except sp.ProcessError:
                pass
        return 0
    if a.json:
        print(json.dumps(r))
    elif a.cmd == "version":
        print(f"squad {r['squad']} ({r['stamp']}), plugin {r['plugin']}, {r['state']}")
    elif r["message"] or not a.quiet:
        print(r["message"] or "process.md is current.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
