#!/usr/bin/env python3
"""Squad process tool: rules, team, upgrade, runtime.

  squad-process lint [--squad-dir D] [--plugin-root R] [--cards error|warn] [--hashes]
                                        check the rule files (templates/squad/process/) and the squad's process.local.md

  squad-process compose <role> --home D [--agent A] [--out F] [--plugin-root R] [--squad-dir D]
                                        composed rules for one role (the <role> --home form)
  squad-process team --home D [--has ROLE]
                                        the scope's team (comma list, `none`, `undecided`); --has ROLE exits 0 (on it) / 1
  squad-process upgrade --check | --apply [--resolve ID=choice ...] [--yes] [--squad-dir D] [--plugin-root R]
                                        composed squads: move the overlay to the running plugin one rule at a time
                                        (exit 0 nothing to decide, 3 a decision is needed, 2 refused)
  squad-process upstream [--squad-dir D] the overlay's `upstream: proposed` operations, ready for a plugin ticket
  squad-process mode --squad-dir D       composed | legacy | none
  squad-process runtime --squad-dir D --home H [--dry-run]
                                        materialise and print the home's pinned plugin runtime
  squad-process prune --squad-dir D (--home H | --all) [--dry-run] [--protect PATH ...]
                                        delete the pinned runtimes no open scope, goal or plugin.pin holds

  squad-process scaffold --squad-dir D
                                        new squad: process.local.md, plugin.pin, settings/*.local.json, project.md
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("mode", "runtime", "prune"):
        import squadruntime  # squad mode and the pinned runtime: ticket 05
        return squadruntime.main(argv)
    if argv and argv[0] == "scaffold":
        import squadscaffold  # new composed squads
        return squadscaffold.main(argv)
    if argv and argv[0] in ("upgrade", "upstream"):
        import squadupgrade  # upgrade one rule at a time: ticket 07
        return squadupgrade.main(argv)
    import squadrules_cli  # every other form: its parser prints the usage error, exit 2
    return squadrules_cli.main(argv)


if __name__ == "__main__":
    sys.exit(main())
