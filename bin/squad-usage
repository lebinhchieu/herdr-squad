#!/usr/bin/env python3
"""Token usage per squad agent, read from Claude Code transcripts.

  squad-usage [--squad-dir DIR]                 table for every roster.md row with a session id
  squad-usage --sessions NAME                   per-session list of an agent: peak ctx, start, 1st act, act turn, turns, last turn (oldest first)
  squad-usage --check SESSION [--transcript F]  print `fresh` when the session is past its respawn line, or nothing
  squad-usage --check-detail SESSION [--transcript F]
                                                like --check, with TAB ctx TAB line TAB turns after the word; prints `none` there when no rule fires (the usage hook's stamp)
  squad-usage --get NAME                        print "role<TAB>scope<TAB>session" of a roster row
  squad-usage --set-session NAME SESSION [--role R --scope S]
                                                record a session id in roster.md (adds the column)

Table columns:
  peak ctx   largest context of the agent's newest session (main thread)
  max peak   largest context of any session of the agent
  1st act    context at the first action of the newest session (an Edit, Write, message or state-changing Bash call);
             `-` before one exists
  act turn   1-based number of the main-thread turn that holds that first action; `-` before one exists
  start      (--sessions only) context of the session's first main-thread turn
Sidechain (subagent) turns are never counted in start, 1st act or act turn.
A roster session with no transcript (after a lazy respawn) is replaced by the newest `spawn` event session of the agent in
usage-events.jsonl that has one; its earlier sessions are then listed too.

Env: SCOPE_DIR, else GOAL_DIR, else SQUAD_DIR: the folder holding roster.md. CLAUDE_CONFIG_DIR (default ~/.claude).
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402
from squadtranscript import TOKEN_FIELDS, agent_sessions, find_transcript, is_expiry, read_lines, read_session  # noqa: E402

ROOM = 50_000                # [COST-3]: a session may grow this much past its first action
CAP = 180_000                # hard upper bound of the line, and the line before a first action exists
ACTION_TOOLS = ("Edit", "Write", "NotebookEdit", "SendMessage")  # a call that edits, writes or sends a message
# A Bash call that changes state counts as a first action too, for sessions that never call an action tool (the
# Manager). Its first word (basename of a path) is one of ACTION_BASH, or it is `git` with a subcommand in ACTION_GIT.
# One leading `cd DIR &&` is skipped. An env prefix, `git -C dir commit` or a later `&&` part count as reads.
ACTION_BASH = ("squad-spawn", "squad-inbox", "squad-start", "squad-close", "squad-retire", "squad-respawn",
               "squad-label", "squad-team")
ACTION_GIT = ("commit", "merge")


def is_action(b):
    """True for a tool_use block that is an action tool call or a state-changing Bash call."""
    if not isinstance(b, dict) or b.get("type") != "tool_use":
        return False
    if b.get("name") in ACTION_TOOLS:
        return True
    cmd = b["input"].get("command") if b.get("name") == "Bash" and isinstance(b.get("input"), dict) else None
    words = cmd.split() if isinstance(cmd, str) else []
    if len(words) > 2 and words[0] == "cd" and words[2] == "&&":
        words = words[3:]
    if not words:
        return False
    first = words[0].replace("\\", "/").rsplit("/", 1)[-1]
    return first in ACTION_BASH or (first == "git" and len(words) > 1 and words[1] in ACTION_GIT)


def first_turns(path):
    """Start and first action of a session's main thread: {"start": ctx of the first turn, "first_action": ctx on the
    first call that edits, writes, sends a message or runs a state-changing Bash command (ACTION_BASH), "act_turn": its
    1-based turn number}. first_action and act_turn are None before an action exists. Sidechain turns are not counted;
    a message spans several lines whose usage only grows, so each turn keeps the max."""
    order, ctx, first = [], {}, None
    for o in read_lines(path):
        m = o.get("message")
        if o.get("type") != "assistant" or o.get("isSidechain") or not isinstance(m, dict):
            continue
        if not isinstance(m.get("usage"), dict) or m.get("model") == "<synthetic>":
            continue  # not a turn: read_session skips it too, so act turn agrees with the turns column
        mid = m.get("id") or o.get("uuid")
        if mid not in ctx:
            order.append(mid)
            ctx[mid] = 0
        if first is None and isinstance(m.get("content"), list) and any(is_action(b) for b in m["content"]):
            first = mid
        ctx[mid] = max(ctx[mid], sum(m["usage"].get(f, 0) for f in TOKEN_FIELDS[:3]))
    return {"start": ctx[order[0]] if order else None, "first_action": None if first is None else ctx[first],
            "act_turn": None if first is None else order.index(first) + 1}


def respawn_line(s):
    """The session's one respawn line: its context at first action + 50k, never above 180k."""
    first = s["first_action"]
    return CAP if first is None else min(first + ROOM, CAP)


def summarize(path):
    """One session. Context, expiries and model follow the agent's own turns; turns and out include its subagents."""
    every, compactions = read_session(path)
    rows = [t for t in every if not t["side"]]
    if not rows:
        return None
    expiries = sum(is_expiry(a, b) for a, b in zip(rows, rows[1:]))
    last = rows[-1]
    return {"model": last["model"], "effort": last["effort"] or "-", "turns": len(rows),
            "subagents": sum(t["out"] for t in every if t["side"]),
            "peak": max(t["ctx"] for t in rows), "last": last["ctx"], "out": sum(t["out"] for t in every),
            "expiries": expiries, "compactions": compactions, "last_ts": last["ts"],
            "just_expired": len(rows) > 1 and is_expiry(rows[-2], last), **first_turns(path)}


def agent_summaries(paths):
    """One summary per usable session of an agent, oldest last turn first; equal timestamps keep path order."""
    return sorted(filter(None, map(summarize, paths)), key=lambda s: s["last_ts"])


def summarize_agent(paths, ss=None):
    """Every session of one agent: turns, out, expiries, compactions sum; the newest session gives ctx and model."""
    ss = agent_summaries(paths) if ss is None else ss
    if not ss:
        return None
    newest = ss[-1]
    return {**newest, **{k: sum(s[k] for s in ss) for k in ("turns", "subagents", "out", "expiries", "compactions")},
            "sessions": len(ss), "max_peak": max(s["peak"] for s in ss)}


def check(s):
    """"fresh" when the session is past its one line (or was compacted), else None. An idle session past the line
    (cache gone) is the same signal: there is no second, idle line."""
    if s["compactions"] or s["last"] > respawn_line(s):
        return "fresh"
    return None


def orphan_fresh(log):
    """Agents whose last `fresh` record in usage-events.jsonl has no later `respawn` or `retire` of the same agent.
    A missing log gives none; a blank, corrupt or non-object line is skipped. Returns [(agent, record)]."""
    last = {}
    try:
        lines = Path(log).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []
    for line in lines:
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if not isinstance(o, dict) or not isinstance(o.get("agent"), str):
            continue
        if o.get("rule") == "fresh":
            last[o["agent"]] = o
        elif o.get("rule") in ("respawn", "retire"):
            last.pop(o["agent"], None)
    return list(last.items())


def table_rows(text):
    return [[c.strip() for c in l.strip().strip("|").split("|")] for l in text.splitlines() if l.startswith("|")]


def roster_sessions(roster):
    rows = table_rows(roster.read_text(encoding="utf-8"))
    if not rows or "Session" not in rows[0]:
        return []
    si, ai = rows[0].index("Session"), rows[0].index("Agent")
    return [(r[ai], r[si]) for r in rows[2:] if len(r) > si and r[si]]


def roster_get(roster, name):
    rows = table_rows(roster.read_text(encoding="utf-8"))
    col = {h: i for i, h in enumerate(rows[0])} if rows else {}
    for r in rows[2:]:
        if r and r[0] == name:
            cell = lambda h: r[col[h]] if h in col and len(r) > col[h] else ""
            return cell("Role"), cell("Scope"), cell("Session")


def set_session(roster, name, session, role="", scope=""):
    lines = roster.read_text(encoding="utf-8").splitlines() if roster.exists() else []
    out, header_seen, width, done = [], False, 0, False
    for l in lines:
        if not l.startswith("|"):
            out.append(l)
            continue
        cells = [c.strip() for c in l.strip().strip("|").split("|")]
        if not header_seen:
            header_seen = True
            if "Session" not in cells:
                cells.append("Session")
            width, si = len(cells), cells.index("Session")
        elif set(l) <= set("|-: "):
            cells = ["---"] * width
        else:
            cells += [""] * (width - len(cells))
            if cells[0] == name:
                cells[si], done = session, True
        out.append("| " + " | ".join(cells) + " |")
    if not header_seen:
        sys.exit(f"no table in {roster}")
    if not done:
        row = [name, role, scope, "", "live"] + [""] * (width - 5)
        row[si] = session
        out.append("| " + " | ".join(row) + " |")
    with open(roster, "w", encoding="utf-8", newline="\n") as f:
        f.write("\n".join(out) + "\n")


def fmt_k(n):
    return f"{n / 1000:.0f}k"


def spawn_sessions(log, name):
    """Session ids of the `spawn` events of `name` in usage-events.jsonl, newest first. A missing log, a corrupt line or
    a record without a session gives none of it. Respawn events carry no session id."""
    try:
        lines = Path(log).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if isinstance(o, dict) and o.get("agent") == name and o.get("rule") == "spawn" and isinstance(o.get("session"), str):
            out.append(o["session"])
    return out[::-1]


def agent_paths(name, sid, squad_dir=None):
    """Transcript paths of one agent and whether a session of it was found: (paths, found, certain). When the roster
    session has no transcript, the newest spawn-event session that has one anchors the search."""
    found = find_transcript(sid)
    if not found and squad_dir:
        found = next(filter(None, map(find_transcript, spawn_sessions(Path(squad_dir) / "usage-events.jsonl", name))), None)
    paths, certain = agent_sessions(name, found)
    if found:
        paths.append(str(found))
    return sorted(set(paths)), found, certain


def sessions_report(squad_dir, name):
    """Per-session list of one agent, oldest first: peak ctx, turns and last turn of each session. Same summarize as the
    table row; the turns add up to the row's turns and the last session's peak is the row's peak ctx."""
    sid = dict(roster_sessions(squad_dir / "roster.md")).get(name)
    if not sid:
        sys.exit(f"{name} has no session id in roster.md")
    ss = agent_summaries(agent_paths(name, sid, squad_dir)[0])
    if not ss:
        print(f"{name}: no transcript")
        return
    rows = [("session", "peak ctx", "start", "1st act", "act turn", "turns", "last turn")]
    rows += [(i, fmt_k(s["peak"]), fmt_k(s["start"]), "-" if s["first_action"] is None else fmt_k(s["first_action"]),
              s["act_turn"] or "-", s["turns"], s["last_ts"].strftime("%Y-%m-%d %H:%M")) for i, s in enumerate(ss, 1)]
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())


def report(squad_dir):
    entries = roster_sessions(squad_dir / "roster.md")
    if not entries:
        sys.exit("no session ids in roster.md")
    head = ("agent", "model/effort", "turns", "peak ctx", "max peak", "last ctx", "1st act", "act turn", "line", "out", "expiries", "compactions", "subagents", "sessions")
    body, seen, unsure = [], set(), []
    for name, sid in entries:
        if name in seen:
            continue
        seen.add(name)
        paths, found, certain = agent_paths(name, sid, squad_dir)
        if not found and not certain:
            unsure.append(name)
        s = summarize_agent(paths)
        if not s:
            body.append((name, "no transcript", "-", "-", "-", "-", "-", "-", "-", "-", "-", "-", "-", "-"))
            continue
        body.append((name, f"{s['model']}/{s['effort']}", s["turns"], fmt_k(s["peak"]), fmt_k(s["max_peak"]), fmt_k(s["last"]),
                     "-" if s["first_action"] is None else fmt_k(s["first_action"]), s["act_turn"] or "-", fmt_k(respawn_line(s)),
                     fmt_k(s["out"]), s["expiries"], s["compactions"],
                     str(s["subagents"]) if s["subagents"] < 1000 else fmt_k(s["subagents"]), s["sessions"]))
    widths = [max(len(str(r[i])) for r in [head] + body) for i in range(len(head))]
    for r in [head] + body:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())
    print("note: turns = main-thread turns only; out includes subagents; subagents = their output tokens (inside out);"
          " peak/last ctx, expiries, model are the agent's own thread;"
          " max peak = the largest peak of any session; sessions = transcripts of the agent (--sessions NAME lists each one's peak and turns);"
          " 1st act = context at the first action, act turn = its main-thread turn number, line = respawn line (1st act + 50k, at most 180k)")
    orphans = orphan_fresh(squad_dir / "usage-events.jsonl")
    if orphans:
        print("note: fresh with no later respawn or retire: " + ", ".join(
            f"{n} ({fmt_k(o['ctx'])}/{fmt_k(o['line'])})" if isinstance(o.get("ctx"), int) and isinstance(o.get("line"), int)
            else n for n, o in orphans))
    if unsure:
        print("note: roster session not found, so the squad could not be told; no other sessions were scanned for: "
              + ", ".join(unsure))


def main():
    squadio.utf8_stdio()
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--squad-dir")
    p.add_argument("--check", metavar="SESSION")
    p.add_argument("--check-detail", metavar="SESSION")
    p.add_argument("--sessions", metavar="NAME")
    p.add_argument("--transcript")
    p.add_argument("--get", metavar="NAME")
    p.add_argument("--set-session", nargs=2, metavar=("NAME", "SESSION"))
    p.add_argument("--role", default="")
    p.add_argument("--scope", default="")
    a = p.parse_args()
    # SQUAD_DIR alone is the legacy flat layout
    squad_dir = a.squad_dir or os.environ.get("SCOPE_DIR") or os.environ.get("GOAL_DIR") or os.environ.get("SQUAD_DIR")

    if a.check or a.check_detail:
        sid = a.check or a.check_detail
        path = Path(a.transcript) if a.transcript else find_transcript(sid)
        s = summarize(path) if path and path.exists() else None
        rule = check(s) if s else None
        if rule:
            print(f"{rule}\t{s['last']}\t{respawn_line(s)}\t{s['turns']}" if a.check_detail else rule)
        elif s and a.check_detail:  # no rule: "none" keeps the tab fields in place (the hook's stamp wants ctx and line)
            print(f"none\t{s['last']}\t{respawn_line(s)}\t{s['turns']}")
        return
    if not squad_dir:
        sys.exit("set SQUAD_DIR or pass --squad-dir")
    if a.sessions:
        sessions_report(Path(squad_dir), a.sessions)
        return
    if a.get:
        row = roster_get(Path(squad_dir) / "roster.md", a.get)
        if not row:
            sys.exit(f"{a.get} is not in roster.md")
        print("\t".join(row))
        return
    if a.set_session:
        set_session(Path(squad_dir) / "roster.md", *a.set_session, role=a.role, scope=a.scope)
        return
    report(Path(squad_dir))


if __name__ == "__main__":
    main()
