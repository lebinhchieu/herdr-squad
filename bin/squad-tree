#!/usr/bin/env python3
"""Data of the /squads pane: every squad, goal and scope of this repo as JSON v1. Read-only. Stdlib only.

  squad-tree [--repo DIR] [--squad NAME]... --json

Exit 0 ok (also when the repo has no squads), 2 refused (bad flag, --repo is not a directory).
"""
import argparse
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        self.exit(2, "squad-tree: %s\n" % message)


def main(argv=None):
    squadio.utf8_stdio()
    import squadtree
    p = _Parser(prog="squad-tree", description="Squads, goals and scopes of this repo as JSON.")
    p.add_argument("--repo", help="repo root (default: from $SQUAD_DIR, else git, else the cwd)")
    p.add_argument("--squad", action="append", default=[], help="only this squad (repeatable)")
    p.add_argument("--json", action="store_true", help="print JSON (the only output form)")
    a = p.parse_args(argv)
    if a.repo and not os.path.isdir(a.repo):
        sys.stderr.write("squad-tree: --repo is not a directory: %s\n" % a.repo)
        return 2
    data = squadtree.build({"repo": squadtree.find_repo(a.repo), "names": a.squad})
    sys.stdout.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
