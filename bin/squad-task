#!/usr/bin/env python3
"""Ticket state events: claim, handin, pass, fail, blocked, merged; warnings W1-W8; gates warn, never block.

  squad-task claim|handin|pass|fail|blocked|merged NN ...   squad-task show [NN]   squad-task from-message

See `squad-task` with no arguments for the options. Exit 0 ok or warning, 2 usage error.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    import squadtask
    return squadtask.run(argv)


if __name__ == "__main__":
    sys.exit(main())
