#!/usr/bin/env python3
"""PreToolUse hook for SendMessage: refuse a HANDIN whose `squad-evidence check` fails (EVID-0, ADR 0034).

The one blocking gate in the squad (LC-27: every other gate only warns). It denies the SendMessage only when the check
ran and exited non-zero; no scope, a message that is not a HANDIN, a check that could not run or any tooling problem
lets the message go. Exit 0 always. Python, so no jq dependency."""
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
sys.dont_write_bytecode = True
from squadio import utf8_stdio  # noqa: E402


def scope_home(raw):
    """$SCOPE_DIR, else the one squad-whoami finds for a resumed session (no SQUAD_* variables)."""
    home = os.environ.get("SCOPE_DIR")
    if not home:
        try:
            out = subprocess.run([sys.executable, os.path.join(HERE, "squad-whoami")], input=raw, capture_output=True,
                                 encoding="utf-8", timeout=10).stdout
            home = dict(x.split("=", 1) for x in out.splitlines() if "=" in x).get("SCOPE_DIR")
        except Exception:
            return None
    return home if home and os.path.isdir(home) else None


def main():
    utf8_stdio()
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw)
        if payload.get("tool_name") != "SendMessage":
            return 0
        text = (payload.get("tool_input") or {}).get("message") or ""
        if not isinstance(text, str) or not text.startswith("HANDIN"):
            return 0
        home = scope_home(raw)
        if not home:
            return 0
        import squadtask
        reason = squadtask.handin_gate(home, text)
        if reason:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                     "permissionDecisionReason": reason}}))
    except Exception:  # a hook must never fail
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
