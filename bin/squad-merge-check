#!/usr/bin/env python3
"""Pre-merge checks in one command (MRG-2, MRG-5, GOAL-7, SQ-6, SQ-7). Read-only: it never merges or writes.

  squad-merge-check <branch-or-sha> [--base REF] [--scope DIR]

Run in the project root. Scope home: --scope or $SCOPE_DIR (the checkers and task states come from there).
Exit 0 ok, 1 refuse, 2 usage error. The last line is `VERDICT: ok` or `VERDICT: refuse: <reasons>`.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    import squadmergecheck
    return squadmergecheck.run(argv)


if __name__ == "__main__":
    sys.exit(main())
