#!/usr/bin/env python3
"""squad-board: a live board of the squad at work.

Iteration 1: replay mode only. Reads a squad folder and serves its state over HTTP.
One file, standard library only, Python 3.9-safe (no `match`, no `X | None` at runtime).
Design: .scratch/squad-board/design.md. Sections below follow its layout.
"""
import argparse
import errno
import hmac
import json
import os
import re
import secrets
import stat
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs

DEFAULT_PORT = 7420
PORT_TRIES = 20  # busy port P: try P+1..P+20 (design D4)
JUMP_PREFIX = "/jump/"
JUMP_NAME_RE = re.compile(r"[a-z][a-z0-9_-]{0,31}")
NOTES_PREFIX = "/notes/"
NOTES_MAX_BYTES = 1 << 20
HERDR_TIMEOUT_S = 5
# Timings of the event stream and the handler socket. The environment overrides exist so tests need
# not wait 15 s; they are read once at startup:
#   SQUAD_BOARD_POLL_S             how often the watcher looks at the squad files (default 0.5)
#   SQUAD_BOARD_KEEPALIVE_S        quiet time before a ": keepalive" comment line (default 15)
#   SQUAD_BOARD_REQUEST_TIMEOUT_S  longest a handler socket read or write may block (default 10)
MAX_ENV_SECONDS = 86400


def env_seconds(name, default):
    """Seconds from the environment, greater than 0 and at most a day, else exit 2 (0 would spin a
    loop; nan, inf and absurd values would never fire)."""
    try:
        value = float(os.environ.get(name, default))
    except ValueError:
        value = 0
    if not 0 < value <= MAX_ENV_SECONDS:
        print("squad-board: %s must be a number between 0 and %d" % (name, MAX_ENV_SECONDS), file=sys.stderr)
        sys.exit(2)
    return value


POLL_S = env_seconds("SQUAD_BOARD_POLL_S", 0.5)
KEEPALIVE_S = env_seconds("SQUAD_BOARD_KEEPALIVE_S", 15)
REQUEST_TIMEOUT_S = env_seconds("SQUAD_BOARD_REQUEST_TIMEOUT_S", 10)

UNLISTED_POD = "(unlisted)"
ITERATION_RE = re.compile(r"[0-9]{1,6}")
STATUS_FOR_EVENT = {"working": "working", "blocked": "blocked", "idle": "idle", "done": "idle"}


class BadRequest(Exception):
    """The client asked for something the state cannot answer: HTTP 400."""


# --- section: squad reader ---

# Logs and squad files are written by other tools; read them as bytes-tolerant text.
def read_text(path):
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def clean_cell(cell):
    return cell.replace("\\|", "|").replace("**", "").replace("`", "").strip()


def strip_parenthetical(cell):
    """`board (S+QAW)` -> `board`: the roster and scopes.md annotate these cells."""
    return re.sub(r"\s*\([^)]*\)\s*$", "", cell)


def read_first_table(path):
    """Rows of the first markdown table in the file, as dicts keyed by lowercased header."""
    table = None
    for line in read_text(path).splitlines():
        line = line.strip()
        if not line.startswith("|"):
            if table is not None:
                break
            continue
        body = re.sub(r"^\||(?<!\\)\|$", "", line)
        cells = [clean_cell(c) for c in re.split(r"(?<!\\)\|", body)]
        if all(re.fullmatch(r":?-{3,}:?", c) for c in cells):
            continue
        if table is None:
            table = {"header": [c.lower() for c in cells], "rows": []}
        else:
            table["rows"].append(dict(zip(table["header"], cells)))
    return table["rows"] if table else []


def read_squad(squad_dir):
    """Roster, scopes, escalations, iteration texts and notes files of a squad folder."""
    d = Path(squad_dir)
    roster, seen = [], set()
    for row in read_first_table(d / "roster.md"):
        agent, role = row.get("agent", ""), row.get("role", "")
        scope = strip_parenthetical(row.get("scope", ""))
        if agent and role and scope and agent not in seen:
            seen.add(agent)
            roster.append({"agent": agent, "role": role, "scope": scope, "status": row.get("status", "")})
    scopes = [{"scope": strip_parenthetical(r.get("scope", "")),
               "size": strip_parenthetical(r.get("size", "")) or None}
              for r in read_first_table(d / "scopes.md")]
    iterations = {}
    for p in (d / "iterations").glob("*.md"):
        if ITERATION_RE.fullmatch(p.stem) and p.is_file():
            iterations[int(p.stem)] = read_text(p)
    # Matching against real file names keeps untrusted agent names out of any path.
    suffix = ".notes.md"
    notes = set(p.name[:-len(suffix)] for p in (d / "roles").glob("*" + suffix) if p.is_file())
    return {"roster": roster, "scopes": scopes, "escalations": read_first_table(d / "escalations.md"),
            "iterations": iterations, "notes": notes}


# --- section: log reader ---

def parse_ts(value):
    """Aware datetime from a log timestamp, or None (not a string, unparseable, or no zone)."""
    if not isinstance(value, str):
        return None
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(value)
    except ValueError:
        return None
    return dt if dt.tzinfo is not None else None


def read_jsonl(path):
    # split on "\n" only: str.splitlines would also cut at U+2028 inside a JSON string
    for line in read_text(path).split("\n"):
        try:
            rec = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if isinstance(rec, dict) and parse_ts(rec.get("ts")) is not None:
            yield rec


def text_or_none(value):
    return value if isinstance(value, str) else None


def int_or_none(value):
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def read_logs(squad_dir):
    """`(messages, activity)` from the two logs. Bad lines are skipped, wrong types become None."""
    d = Path(squad_dir)
    messages, seen = [], set()
    for rec in read_jsonl(d / "messages.jsonl"):
        msg_id = text_or_none(rec.get("msg_id"))
        if msg_id is not None:
            if msg_id in seen:
                continue
            seen.add(msg_id)
        messages.append({"ts": rec["ts"], "msg_id": msg_id, "from": text_or_none(rec.get("from")),
                         "to": text_or_none(rec.get("to")), "type": text_or_none(rec.get("type")),
                         "task": text_or_none(rec.get("task")), "text": text_or_none(rec.get("text")),
                         "iteration": int_or_none(rec.get("iteration"))})
    activity = []
    for rec in read_jsonl(d / "activity.jsonl"):
        agent = text_or_none(rec.get("agent"))
        if agent:
            activity.append({"ts": rec["ts"], "agent": agent, "status": text_or_none(rec.get("status")),
                             "iteration": int_or_none(rec.get("iteration"))})
    return messages, activity


# --- section: columns ---

def is_manager(role):
    return (role or "").lower() == "manager"


def make_column(agent, role, pod, retired, status, notes):
    return {"agent": agent, "role": role, "pod": pod, "status": status, "retired": retired,
            "notes_path": "roles/%s.notes.md" % agent if agent in notes else None,
            "working_s": 0, "blocked_s": 0, "wakes": 0,
            "context_tokens": None, "tokens_in": None, "tokens_out": None, "model": None}


def latest_statuses(activity):
    """Agent -> status of its latest event; `unknown` and other values are ignored."""
    latest = {}
    for i, event in enumerate(activity):
        if event["status"] not in STATUS_FOR_EVENT:
            continue
        key = (parse_ts(event["ts"]), i)
        if event["agent"] not in latest or key >= latest[event["agent"]][0]:
            latest[event["agent"]] = (key, STATUS_FOR_EVENT[event["status"]])
    return {agent: status for agent, (_, status) in latest.items()}


def build_columns(squad, messages, activity):
    """One column per agent: Manager first, pods by first appearance, roster order inside a pod."""
    statuses = latest_statuses(activity)
    roster = squad["roster"]
    manager = next((r for r in roster if is_manager(r["role"])), None)
    ordered = ([manager] if manager else []) + [r for r in roster if r is not manager]

    pods = {}
    for r in ordered:
        pods.setdefault(r["scope"], []).append(make_column(
            r["agent"], r["role"], r["scope"], r["status"].lower() != "live",
            statuses.get(r["agent"], "idle"), squad["notes"]))

    # An agent seen only in a log joins the end of the pod named by its first matching name part.
    # The Manager's pod is no target: `dev-all-1` is not one of the Manager's team.
    manager_pod = manager["scope"] if manager else None
    known = set(r["agent"] for r in ordered)
    sightings = [(parse_ts(m["ts"]), name) for m in messages for name in (m["from"], m["to"]) if name]
    sightings += [(parse_ts(a["ts"]), a["agent"]) for a in activity]
    for _, name in sorted(sightings, key=lambda s: s[0]):
        if name in known:
            continue
        known.add(name)
        pod = next((part for part in name.split("-") if part in pods and part != manager_pod), UNLISTED_POD)
        pods.setdefault(pod, []).append(make_column(
            name, None, pod, False, statuses.get(name, "idle"), squad["notes"]))
    return [col for pod in pods.values() for col in pod]


def build_pods(squad, columns):
    sizes = {}
    for s in squad["scopes"]:
        sizes.setdefault(s["scope"], s["size"])
    pods = {}
    for col in columns:
        pods.setdefault(col["pod"], []).append(col)
    return [{"name": name,
             "size": None if any(is_manager(c["role"]) for c in cols) else sizes.get(name),
             "agents": [c["agent"] for c in cols]}
            for name, cols in pods.items()]


# --- section: timeline ---

FOLD_GAP_S = 180    # D5: a longer quiet stretch between two visible rows folds into one gap row
WAKE_WINDOW_S = 2   # D7: the hook can stamp `working` just before the message that woke the agent
MICROS = 10 ** 6
EPOCH = datetime(1970, 1, 1, tzinfo=timezone.utc)
BAR_STATUSES = ("working", "blocked", "idle", "done")


def micros(ts):
    """Integer microseconds since the epoch: exact, so boundary tests never meet float noise."""
    delta = parse_ts(ts) - EPOCH
    return (delta.days * 86400 + delta.seconds) * MICROS + delta.microseconds


def whole_seconds(start_us, end_us):
    """Floored seconds, never negative: a skewed clock gives 0."""
    return max(0, (end_us - start_us) // MICROS)


def open_segment(bar):
    seg = bar["blocked"][-1] if bar["blocked"] else None
    return seg if seg is not None and seg["end_us"] is None else None


class TimelineBuilder:
    """Replays all records once, in time order, and collects rows, bars and blocked segments.

    Rows and bars are referred to by their index in the unfiltered run; the iteration filter and
    the gap folding renumber them afterwards.
    """

    def __init__(self, lowest_iteration):
        self.lowest = lowest_iteration
        self.rows = []   # (row, µs, iteration)
        self.bars = []   # every bar, in start order
        self.open = {}   # agent -> its open bar

    def add_row(self, row, rec, us):
        self.rows.append((row, us, rec["iteration"] if rec["iteration"] is not None else self.lowest))
        return len(self.rows) - 1

    def start_bar(self, agent, row_index, self_start):
        if agent in self.open:
            return
        row, us, iteration = self.rows[row_index]
        bar = {"agent": agent, "start": row_index, "end": None, "start_ts": row["ts"], "end_ts": None,
               "start_us": us, "end_us": None, "self_start": self_start, "iteration": iteration,
               "blocked": []}
        self.open[agent] = bar
        self.bars.append(bar)

    def close_segment(self, bar, row_index):
        seg = open_segment(bar)
        if seg is not None:
            row, us, _ = self.rows[row_index]
            seg.update(end=row_index, end_ts=row["ts"], end_us=us)

    def message(self, rec, us):
        row = {"kind": "message", "ts": rec["ts"], "from": rec["from"], "to": rec["to"],
               "type": rec["type"], "task": rec["task"], "text": rec["text"], "msg_id": rec["msg_id"]}
        index = self.add_row(row, rec, us)
        if rec["from"]:
            self.start_bar(rec["from"], index, True)
        if rec["to"]:
            self.start_bar(rec["to"], index, False)

    def status(self, rec, us, woken_by_message):
        agent, status = rec["agent"], rec["status"]
        bar = self.open.get(agent)
        row = {"kind": "status", "ts": rec["ts"], "agent": agent, "status": status}
        if status == "working":
            if bar is None:
                if not woken_by_message:
                    self.start_bar(agent, self.add_row(row, rec, us), True)
            elif open_segment(bar) is not None:
                self.close_segment(bar, self.add_row(row, rec, us))
        elif status == "blocked":
            if bar is not None and open_segment(bar) is not None:
                return
            index = self.add_row(row, rec, us)
            self.start_bar(agent, index, True)
            self.open[agent]["blocked"].append({"start": index, "end": None, "start_ts": rec["ts"],
                                                "end_ts": None, "start_us": us, "end_us": None})
        elif bar is not None:
            row["duration_s"] = whole_seconds(bar["start_us"], us)
            index = self.add_row(row, rec, us)
            self.close_segment(bar, index)
            bar.update(end=index, end_ts=rec["ts"], end_us=us)
            del self.open[agent]


def replay_records(messages, activity, lowest_iteration):
    """Feed messages and status events to a TimelineBuilder in time order (message first on a tie)."""
    events = [(micros(m["ts"]), 0, i, m) for i, m in enumerate(messages)]
    events += [(micros(a["ts"]), 1, i, a) for i, a in enumerate(activity) if a["status"] in BAR_STATUSES]
    events.sort(key=lambda e: e[:3])
    incoming = {}  # agent -> times of the messages sent to it, for the D7 look-ahead
    for us, kind, _, rec in events:
        if kind == 0 and rec["to"]:
            incoming.setdefault(rec["to"], []).append(us)
    seen = dict.fromkeys(incoming, 0)  # events come in time order, so each list is walked once
    builder = TimelineBuilder(lowest_iteration)
    for us, kind, _, rec in events:
        if kind == 0:
            builder.message(rec, us)
            continue
        agent, times, woken = rec["agent"], incoming.get(rec["agent"], ()), False
        if times:
            while seen[agent] < len(times) and times[seen[agent]] <= us:
                seen[agent] += 1
            woken = seen[agent] < len(times) and times[seen[agent]] - us <= WAKE_WINDOW_S * MICROS
        builder.status(rec, us, woken)
    return builder


def fold_rows(rows, selected_iteration):
    """Visible rows with `id`s and gap rows. Returns `(rows, {unfiltered index: id})`."""
    out, ids, previous = [], {}, None
    for index, (row, us, iteration) in enumerate(rows):
        if selected_iteration is not None and iteration != selected_iteration:
            continue
        if previous is not None and us - previous[1] > FOLD_GAP_S * MICROS:
            out.append({"id": len(out), "kind": "gap", "ts": previous[0]["ts"],
                        "seconds": (us - previous[1]) // MICROS,
                        "from_ts": previous[0]["ts"], "to_ts": row["ts"]})
        ids[index] = len(out)
        out.append(dict(row, id=len(out)))
        previous = (row, us)
    return out, ids


def finish_bar(bar, ids, now_us):
    """A bar as the state shows it. A row that is not visible in this iteration becomes null;
    its timestamp stays, so the bar is closed, not open."""
    end_us = bar["end_us"] if bar["end_us"] is not None else now_us
    segments = []
    for seg in bar["blocked"]:
        seg_end = seg["end_us"] if seg["end_us"] is not None else now_us
        segments.append({"start_row": ids.get(seg["start"]), "end_row": ids.get(seg["end"]),
                         "start_ts": seg["start_ts"], "end_ts": seg["end_ts"],
                         "duration_s": whole_seconds(seg["start_us"], seg_end)})
    return {"agent": bar["agent"], "start_row": ids.get(bar["start"]), "end_row": ids.get(bar["end"]),
            "start_ts": bar["start_ts"], "end_ts": bar["end_ts"], "self_start": bar["self_start"],
            "open": bar["end_us"] is None, "duration_s": whole_seconds(bar["start_us"], end_us),
            "blocked": segments}


def derive_timeline(messages, activity, columns, now, selected_iteration, lowest_iteration=None):
    """Rows, bars and per-agent totals. Totals cover the whole run; rows and bars only the selected
    iteration. A record without an iteration counts as `lowest_iteration`."""
    now_us = micros(now)
    builder = replay_records(messages, activity, lowest_iteration)
    rows, ids = fold_rows(builder.rows, selected_iteration)
    agents = dict((c["agent"], {"working_s": 0, "blocked_s": 0, "wakes": 0}) for c in columns)
    bars = []
    for bar in builder.bars:
        shown = finish_bar(bar, ids, now_us)
        totals = agents.setdefault(bar["agent"], {"working_s": 0, "blocked_s": 0, "wakes": 0})
        totals["working_s"] += shown["duration_s"]
        totals["blocked_s"] += sum(seg["duration_s"] for seg in shown["blocked"])
        totals["wakes"] += 0 if bar["self_start"] else 1
        if selected_iteration is None or bar["iteration"] == selected_iteration:
            bars.append(shown)
    return {"rows": rows, "bars": bars, "agents": agents}


# --- section: tasks ---

TASK_STATE_FOR_TYPE = {"DECISION": "building", "STATUS": "building", "BLOCKED": "blocked",
                       "HANDIN": "checking", "FAIL": "returned", "PASS": "done"}
# ASK and ANSWER keep the state but make a task appear (as building) when they name it first.
TASK_TYPES = set(TASK_STATE_FOR_TYPE) | {"ASK", "ANSWER"}


def in_iteration(record, upto):
    """A record without an iteration counts as the lowest one; no iteration files filter nothing."""
    return upto is None or record["iteration"] is None or record["iteration"] <= upto


def derive_tasks(messages, activity, upto_iteration):
    """Task states as of the end of `upto_iteration`, in order of first appearance."""
    # Messages sort before activity at the same time (as in the timeline); log order breaks the rest.
    events = [(parse_ts(m["ts"]), 0, i, m) for i, m in enumerate(messages)
              if m["type"] in TASK_TYPES and m["task"] and in_iteration(m, upto_iteration)]
    events += [(parse_ts(a["ts"]), 1, i, a) for i, a in enumerate(activity)
               if a["status"] == "working" and in_iteration(a, upto_iteration)]
    tasks, blocked_by = {}, {}
    for _, is_activity, _, rec in sorted(events, key=lambda e: e[:3]):
        if is_activity:
            for task in tasks.values():
                if task["state"] == "blocked" and blocked_by[task["id"]] == rec["agent"]:
                    task["state"] = "building"
            continue
        task = tasks.setdefault(rec["task"], {"id": rec["task"], "state": "building", "returns": 0,
                                              "last_ts": None, "last_type": None})
        if rec["type"] in TASK_STATE_FOR_TYPE:
            task["state"] = TASK_STATE_FOR_TYPE[rec["type"]]
        if rec["type"] == "BLOCKED":
            blocked_by[rec["task"]] = rec["from"]
        if rec["type"] == "FAIL":
            task["returns"] += 1
        task["last_ts"], task["last_type"] = rec["ts"], rec["type"]
    return list(tasks.values())


# --- section: needs-you ---

def po_checkin_filled(text):
    """Which of `done` / `next` have text in the `## PO check-in` section; None without the section.

    Text on the bullet line or on any line under it (until the next bullet) counts as filled.
    """
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines) if re.match(r"##\s+PO check-in\b", line, re.I)), None)
    if start is None:
        return None
    filled, field = {"done": False, "next": False}, None
    for line in lines[start + 1:]:
        heading = re.match(r"(#+)\s", line)
        if heading:
            if len(heading.group(1)) <= 2:
                break
            field = None
            continue
        bullet = re.match(r"[-*]\s+\*\*(\w+)[^*]*\*\*:?(.*)", line)
        if bullet:
            field, line = bullet.group(1).lower(), bullet.group(2)
        if field in filled and line.strip(" \t-*"):
            filled[field] = True
    return filled


def latest_event_ts(activity, agent, statuses):
    """Time of the agent's latest event with one of these statuses (log order breaks ties)."""
    stamps = [(parse_ts(a["ts"]), i, a["ts"]) for i, a in enumerate(activity)
              if a["agent"] == agent and a["status"] in statuses]
    return max(stamps)[2] if stamps else None


def derive_needs_you(squad, columns, activity):
    """Blocked agents (roster order), then unanswered escalations, then the idle Manager."""
    rank = {r["agent"]: i for i, r in enumerate(squad["roster"])}
    items = []
    for col in sorted(columns, key=lambda c: rank.get(c["agent"], len(rank))):
        if col["status"] == "blocked" and not col["retired"]:
            since = latest_event_ts(activity, col["agent"], ("blocked",))
            items.append({"id": "blocked:%s:%s" % (col["agent"], since), "kind": "blocked",
                          "text": "%s is blocked" % col["agent"], "agent": col["agent"], "since": since})

    rows = squad["escalations"]
    numbers = [r.get("#", "") for r in rows]
    for i, row in enumerate(rows, 1):
        # a blank row has an empty Answer too, but without a number or question it is no escalation
        if row.get("answer") or not (row.get("#") or row.get("question")):
            continue
        number = numbers[i - 1] if numbers[i - 1] and numbers.count(numbers[i - 1]) == 1 else i
        items.append({"id": "escalation:%s" % number, "kind": "escalation",
                      "text": row.get("question", ""), "agent": None, "since": None})

    manager = next((r["agent"] for r in squad["roster"] if is_manager(r["role"])), None)
    manager_col = next((c for c in columns if c["agent"] == manager), None)
    since = latest_event_ts(activity, manager, tuple(STATUS_FOR_EVENT))
    if manager_col and not manager_col["retired"] and since and manager_col["status"] == "idle" \
            and squad["iterations"]:
        current = max(squad["iterations"])
        filled = po_checkin_filled(squad["iterations"][current])
        if filled is not None and not any(filled.values()):
            items.append({"id": "manager_idle:%d" % current, "kind": "manager_idle",
                          "text": "Manager is idle and the PO check-in of iteration %d is empty" % current,
                          "agent": manager, "since": since})
    return items


# --- section: tokens ---

SESSION_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")
SYNTHETIC_MODEL = "<synthetic>"
HEAD_BYTES = 64  # a rewritten file that grew past the old offset is caught by comparing its start

# Per transcript (by real path): the reader's place and the replies seen so far. The server is
# threaded, so `_cache_lock` guards the dict and each entry's own lock guards its read, which
# keeps one agent's file I/O from blocking another's.
_cache = {}
_cache_lock = threading.Lock()


def count(value):
    """A usage field that is not a non-negative int counts as 0 (the reply itself still counts)."""
    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else 0


def parse_reply(line):
    """`(message_id, tokens_in, tokens_out, model)` of an assistant line with usage, else None.

    A `<synthetic>` reply (Claude Code's own placeholder, usage all zero) is skipped: as the last
    reply it would show a context of 0."""
    if b'"usage"' not in line:  # cheap filter: most transcript lines are tool output
        return None
    try:
        rec = json.loads(line.decode("utf-8", errors="replace"))
    except (ValueError, RecursionError):
        return None
    message = rec.get("message") if isinstance(rec, dict) and rec.get("type") == "assistant" else None
    usage = message.get("usage") if isinstance(message, dict) else None
    if not isinstance(usage, dict) or message.get("model") == SYNTHETIC_MODEL:
        return None
    tokens_in = sum(count(usage.get(k)) for k in
                    ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
    return text_or_none(message.get("id")), tokens_in, count(usage.get("output_tokens")), \
        text_or_none(message.get("model"))


def refresh_entry(entry, path):
    """Read what was appended to `path` since last time. False when the file cannot be read."""
    with entry["lock"]:
        try:
            with open(path, "rb") as f:
                head = f.read(len(entry["head"]))
                if os.fstat(f.fileno()).st_size < entry["offset"] or head != entry["head"]:
                    entry.update(offset=0, head=b"", replies={}, anonymous=0)
                f.seek(entry["offset"])
                for line in iter(f.readline, b""):
                    if not line.endswith(b"\n"):
                        break  # still being written: read it again once it is complete
                    entry["offset"] += len(line)
                    reply = parse_reply(line)
                    if reply is None:
                        continue
                    msg_id = reply[0]
                    if msg_id is None:
                        entry["anonymous"] += 1
                        msg_id = "anonymous-%d" % entry["anonymous"]
                    # last line wins, and moves the reply to the end: it is the latest by position
                    entry["replies"].pop(msg_id, None)
                    entry["replies"][msg_id] = reply[1:]
                f.seek(0)
                entry["head"] = f.read(min(entry["offset"], HEAD_BYTES))
        except OSError:
            return False
        return True


def transcript_figures(path):
    with _cache_lock:
        entry = _cache.setdefault(path, {"lock": threading.Lock(), "offset": 0, "head": b"",
                                         "replies": {}, "anonymous": 0})
    if not refresh_entry(entry, path):
        return None
    with entry["lock"]:
        replies = list(entry["replies"].values())
    if not replies:
        return None
    models = [model for _, _, model in replies if model]
    return {"context_tokens": replies[-1][0], "tokens_in": sum(r[0] for r in replies),
            "tokens_out": sum(r[1] for r in replies), "model": models[-1] if models else None}


def inside(path, root):
    return os.path.commonpath([path, root]) == root


def read_sessions(replay):
    """Agent -> valid session id from `replay/herdr.json`; anything odd is left out."""
    path = os.path.realpath(replay / "herdr.json")
    if not inside(path, os.path.realpath(replay)):
        return {}
    try:
        agents = json.loads(read_text(Path(path))).get("agents")
    except (ValueError, RecursionError, AttributeError):
        return {}
    sessions = {}
    for name, entry in (agents.items() if isinstance(agents, dict) else ()):
        sid = entry.get("session_id") if isinstance(entry, dict) else None
        if isinstance(sid, str) and SESSION_ID_RE.fullmatch(sid):
            sessions[name] = sid
    return sessions


def find_transcript(replay, session_id):
    """Real path of the transcript under any `replay/claude*` root; symlinked roots count once."""
    root = os.path.realpath(replay)
    found = set(os.path.realpath(p) for p in replay.glob("claude*/projects/*/%s.jsonl" % session_id))
    return min((p for p in found if inside(p, root)), default=None)


def read_tokens(columns, replay_root):
    """Token figures per agent that has a readable transcript; the others are left out (null)."""
    replay = Path(replay_root) / "replay"
    sessions = read_sessions(replay)
    tokens = {}
    for col in columns:
        path = find_transcript(replay, sessions[col["agent"]]) if col["agent"] in sessions else None
        found = transcript_figures(path) if path else None
        if found:
            tokens[col["agent"]] = found
    return tokens


# --- section: state ---

def latest_ts(messages, activity):
    stamps = [r["ts"] for r in messages + activity]
    return max(stamps, key=parse_ts) if stamps else None


def build_state(squad_dir, now=None, selected_iteration=None):
    """The whole board state from files alone. Raises BadRequest for an unknown iteration."""
    squad = read_squad(squad_dir)
    messages, activity = read_logs(squad_dir)
    iterations = sorted(squad["iterations"])
    iteration = iterations[-1] if iterations else None
    if selected_iteration is None:
        selected_iteration = iteration
    elif selected_iteration not in squad["iterations"]:
        raise BadRequest("unknown iteration %d" % selected_iteration)
    now = now or latest_ts(messages, activity) or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    columns = build_columns(squad, messages, activity)
    timeline = derive_timeline(messages, activity, columns, now, selected_iteration,
                               iterations[0] if iterations else None)
    tokens = read_tokens(columns, squad_dir)
    for col in columns:
        for key in ("working_s", "blocked_s", "wakes"):
            col[key] = timeline["agents"].get(col["agent"], {}).get(key, col[key])
        for key in ("context_tokens", "tokens_in", "tokens_out", "model"):
            col[key] = tokens.get(col["agent"], {}).get(key, col[key])
    return {"now": now, "iterations": iterations, "iteration": iteration,
            "selected_iteration": selected_iteration, "pods": build_pods(squad, columns),
            "columns": columns, "rows": timeline["rows"], "bars": timeline["bars"],
            "tasks": derive_tasks(messages, activity, selected_iteration),
            "needs_you": derive_needs_you(squad, columns, activity),
            "live": False}  # replay mode; the live mode of iteration 2 reports True


# --- section: http ---

# The page sits next to the real script file, so a symlink in a bin/ folder still finds it.
PAGE_PATH = Path(os.path.realpath(__file__)).parent / "squad-board.html"
# design-iteration-2 E10: the page runs only its own inline script and talks only to this server
PAGE_HEADERS = (
    ("Content-Security-Policy", "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
     "connect-src 'self'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"),
    ("Referrer-Policy", "no-referrer"),
)


def send(handler, status, content_type, body, extra_headers=()):
    handler.send_response(status)
    handler.send_header("Content-Type", content_type)
    handler.send_header("Content-Length", str(len(body)))
    handler.send_header("Cache-Control", "no-store")
    for name, value in extra_headers:
        handler.send_header(name, value)
    if content_type.startswith("application/json"):
        handler.send_header("X-Content-Type-Options", "nosniff")
    handler.end_headers()
    handler.wfile.write(body)


def send_json(handler, status, obj):
    send(handler, status, "application/json; charset=utf-8", json.dumps(obj).encode("utf-8"))


def check_request(handler):
    """Host and Origin must name this server, else 403: a web page on another site (or a rebinding
    DNS name) cannot talk to it. Runs before method, token and path, for every route."""
    port = handler.server.server_address[1]
    hosts = ["127.0.0.1:%d" % port, "localhost:%d" % port]
    given = handler.headers.get_all("Host") or []
    origins = handler.headers.get_all("Origin") or []
    if (len(given) == 1 and given[0].lower() in hosts
            and all(o.lower() in ["http://" + h for h in hosts] for o in origins)):
        return True
    send_json(handler, 403, {"error": "forbidden"})
    return False


def token_ok(handler):
    """Constant-time compare on UTF-8 bytes: a non-ASCII header is a mismatch, not a TypeError.
    A repeated header must have every copy right."""
    expected = handler.server.token.encode("utf-8")
    given = handler.headers.get_all("X-Board-Token") or []
    return bool(given) and all(hmac.compare_digest(g.encode("utf-8"), expected) for g in given)


def handle_root(handler):
    """GET /: the page file, read on every request so an edit shows on reload. The error text names
    no path."""
    try:
        body = PAGE_PATH.read_bytes()
    except OSError:
        return send_json(handler, 500, {"error": "page file missing"})
    send(handler, 200, "text/html; charset=utf-8", body, PAGE_HEADERS)


def query_iteration(handler):
    """The `iteration` query value as an int, or None when absent. Raises BadRequest."""
    values = parse_qs(handler.path.partition("?")[2], keep_blank_values=True).get("iteration")
    if values is None:
        return None
    if len(values) != 1 or not ITERATION_RE.fullmatch(values[0]):
        raise BadRequest("iteration must be a number")
    return int(values[0])


def handle_state(handler):
    try:
        state = build_state(handler.server.replay_dir, handler.server.now, query_iteration(handler))
    except BadRequest as e:
        return send_json(handler, 400, {"error": str(e)})
    send_json(handler, 200, state)


def watched_signature(squad_dir):
    """What the squad files look like right now. The inode is part of it, so an editor that writes a
    temp file and renames it over the original is seen even when size and mtime come out equal."""
    root = Path(squad_dir)
    paths = [root / name for name in ("messages.jsonl", "activity.jsonl", "escalations.md", "roster.md", "scopes.md")]
    paths += sorted(root.glob("iterations/*.md")) + sorted(root.glob("roles/*.notes.md"))
    signature = []
    for path in paths:
        try:
            info = path.stat()
        except OSError:
            signature.append((str(path), None))  # missing counts as a state of its own
        else:
            signature.append((str(path), info.st_size, info.st_mtime_ns, info.st_ino))
    return tuple(signature)


class StateWatcher:
    """One thread looks at the squad files; a state is built once per change and iteration, however
    many streams are open. Streams wait on `changed` and never touch the files themselves."""

    def __init__(self, squad_dir, now):
        self.squad_dir = squad_dir
        self.now = now
        self.changed = threading.Condition()
        self.version = 0
        self.signature = watched_signature(squad_dir)
        self.built = {}  # selected iteration -> (state without `now`, its JSON), for this version
        threading.Thread(target=self.watch, daemon=True).start()

    def refresh(self):
        with self.changed:
            signature = watched_signature(self.squad_dir)
            if signature != self.signature:
                self.signature = signature
                self.version += 1
                self.built = {}
                self.changed.notify_all()

    def watch(self):
        while True:
            try:
                self.refresh()
            except Exception as e:  # one bad poll must not end the watching
                print("squad-board: watcher: %s" % e, file=sys.stderr, flush=True)
            time.sleep(POLL_S)

    def snapshot(self, selected):
        """(version, state, JSON) for the files as they are now. Raises BadRequest for an unknown
        iteration. Looks at the files first, so a new connection never gets a stale state."""
        self.refresh()
        with self.changed:
            if selected not in self.built:
                state = build_state(self.squad_dir, self.now, selected)
                # `now` is left out of the comparison: a clock tick alone is not a change
                self.built[selected] = ({k: v for k, v in state.items() if k != "now"}, json.dumps(state))
            state, data = self.built[selected]
            return self.version, state, data

    def wait_after(self, version, timeout):
        """The current version, once it differs from `version` or `timeout` seconds have passed."""
        with self.changed:
            self.changed.wait_for(lambda: self.version != version, timeout)
            return self.version


def handle_events(handler):
    """GET /events: the state now, then again whenever it changes, plus a keepalive comment line
    when nothing was sent for KEEPALIVE_S. The iteration is fixed for the connection."""
    watcher = handler.server.watcher
    try:
        selected = query_iteration(handler)
        version, state, data = watcher.snapshot(selected)
    except BadRequest as e:
        return send_json(handler, 400, {"error": str(e)})
    handler.send_response(200)
    handler.send_header("Content-Type", "text/event-stream; charset=utf-8")
    handler.send_header("Cache-Control", "no-store")
    handler.end_headers()
    handler.close_connection = True
    try:
        handler.wfile.write(("event: state\ndata: %s\n\n" % data).encode("utf-8"))
        last_write = time.monotonic()
        while True:
            quiet = time.monotonic() - last_write
            if quiet >= KEEPALIVE_S:
                handler.wfile.write(b": keepalive\n\n")
                last_write = time.monotonic()
                continue
            current = watcher.wait_after(version, KEEPALIVE_S - quiet)
            if current == version:
                continue
            version = current
            try:
                version, new_state, data = watcher.snapshot(selected)
            except Exception as e:  # e.g. the pinned iteration file was deleted: wait for the next change
                print("squad-board: state not rebuilt: %s" % e, file=sys.stderr, flush=True)
                continue
            if new_state != state:
                state = new_state
                handler.wfile.write(("event: state\ndata: %s\n\n" % data).encode("utf-8"))
                last_write = time.monotonic()
    except OSError:
        pass  # the client went away, or stopped reading for longer than REQUEST_TIMEOUT_S


# design-iteration-2 "Notes route" step 8: the text is shown, never run, never framed, never cached
NOTES_HEADERS = (
    ("X-Content-Type-Options", "nosniff"),
    ("Content-Security-Policy", "sandbox; default-src 'none'"),
    ("Referrer-Policy", "no-referrer"),
    ("Content-Disposition", "inline"),
)


def send_notes(handler, status, text):
    send(handler, status, "text/plain; charset=utf-8", text, NOTES_HEADERS)


def notes_token_ok(handler):
    """The `token` query value: exactly one, compared as UTF-8 bytes (a link cannot send a header)."""
    values = parse_qs(handler.path.partition("?")[2], keep_blank_values=True).get("token") or []
    return len(values) == 1 and hmac.compare_digest(values[0].encode("utf-8"), handler.server.token.encode("utf-8"))


def read_notes(squad_dir, name):
    """The first NOTES_MAX_BYTES of `<squad>/roles/<name>.notes.md` as bytes, or None. `name` is
    already validated. The real path must stay inside the real roles folder, so a symlink leading
    out is refused; the open is non-blocking and re-checked on the descriptor, so a file swapped for
    a pipe after the check cannot hang the handler."""
    roles = os.path.realpath(os.path.join(squad_dir, "roles"))
    real = os.path.realpath(os.path.join(roles, name + ".notes.md"))
    if os.path.dirname(real) != roles:
        return None
    try:
        fd = os.open(real, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        with os.fdopen(fd, "rb", closefd=False) as f:
            return f.read(NOTES_MAX_BYTES)
    except OSError:
        return None
    finally:
        os.close(fd)


def handle_notes(handler):
    """GET /notes/<name>?token=...: an agent's notes file as plain text. Check order: token, name,
    roster, file, so a refused token never reveals who is on the roster."""
    if not notes_token_ok(handler):
        return send_notes(handler, 403, b"forbidden")
    name = handler.path.partition("?")[0][len(NOTES_PREFIX):]
    if not JUMP_NAME_RE.fullmatch(name):
        return send_notes(handler, 400, b"bad agent name")
    # a retired agent stays: its notes outlive it
    if name not in [r["agent"] for r in read_squad(handler.server.replay_dir)["roster"]]:
        return send_notes(handler, 404, b"not found")
    data = read_notes(handler.server.replay_dir, name)
    if data is None:
        return send_notes(handler, 404, b"not found")
    send_notes(handler, 200, data.decode("utf-8", errors="replace").encode("utf-8"))


def handle_jump(handler):
    """POST /jump/<name>: focus a roster agent's herdr pane. Check order: token, name, roster, so a
    refused token never reveals who is on the roster. Nothing is run until all three pass."""
    if not token_ok(handler):
        return send_json(handler, 403, {"error": "forbidden"})
    name = handler.path.partition("?")[0][len(JUMP_PREFIX):]
    if not JUMP_NAME_RE.fullmatch(name):
        return send_json(handler, 400, {"error": "bad agent name"})
    live = [r["agent"] for r in read_squad(handler.server.replay_dir)["roster"]
            if r["status"].lower() == "live"]
    if name not in live:
        return send_json(handler, 404, {"error": "not on the roster"})
    # argv list, never a shell; herdr's own output stays out of the response
    try:
        done = subprocess.run(["herdr", "agent", "focus", name], timeout=HERDR_TIMEOUT_S,
                              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return send_json(handler, 502, {"ok": False, "error": "herdr timed out"})
    except OSError:
        return send_json(handler, 502, {"ok": False, "error": "herdr could not be run"})
    if done.returncode != 0:
        return send_json(handler, 502, {"ok": False, "error": "herdr exited with status %d" % done.returncode})
    send_json(handler, 200, {"ok": True})


class BoardHandler(BaseHTTPRequestHandler):
    # StreamRequestHandler puts this on the connection socket: a client that connects and sends
    # nothing frees its thread after REQUEST_TIMEOUT_S. The event stream only writes, so a quiet
    # one is not cut; a stuck write (a client that stopped reading) times out the same way.
    timeout = REQUEST_TIMEOUT_S

    def do_GET(self):
        if not check_request(self):
            return
        path = self.path.partition("?")[0]
        if path.startswith(JUMP_PREFIX):
            send_json(self, 405, {"error": "method not allowed"})
        elif path.startswith(NOTES_PREFIX):
            handle_notes(self)
        elif path == "/":
            handle_root(self)
        elif path == "/state":
            handle_state(self)
        elif path == "/events":
            handle_events(self)
        else:
            send_json(self, 404, {"error": "not found"})

    def do_POST(self):
        if not check_request(self):
            return
        path = self.path.partition("?")[0]
        if path.startswith(JUMP_PREFIX):
            handle_jump(self)
        elif path.startswith(NOTES_PREFIX):
            send_json(self, 405, {"error": "method not allowed"})
        else:
            send_json(self, 404, {"error": "not found"})

    def method_not_allowed(self):
        if check_request(self):
            send_json(self, 405, {"error": "method not allowed"})

    do_HEAD = do_OPTIONS = do_PUT = do_PATCH = do_DELETE = method_not_allowed

    def send_error(self, code, message=None, explain=None):
        # the stock error page is HTML without our headers
        send_json(self, code, {"error": message or self.responses.get(code, ("error",))[0]})

    def log_message(self, format, *args):
        # a request line on stderr would break the "silent when healthy" contract
        pass


class BoardServer(ThreadingHTTPServer):
    daemon_threads = True


def make_server(replay_dir, now, port):
    """Bind `port` on loopback, or the next free one of the following PORT_TRIES (not for port 0).
    Raises OSError when the port cannot be bound; the last EADDRINUSE when all are busy."""
    last = min(port + PORT_TRIES, 65535) if port else 0
    for candidate in range(port, last + 1):
        try:
            server = BoardServer(("127.0.0.1", candidate), BoardHandler)
        except OSError as e:
            if e.errno != errno.EADDRINUSE or candidate == last:
                raise
            continue
        server.replay_dir = replay_dir
        server.now = now
        server.token = secrets.token_urlsafe(16)
        server.watcher = StateWatcher(replay_dir, now)
        return server


def die(message, code):
    print("squad-board: " + message, file=sys.stderr)
    return code


def main(argv=None):
    parser = argparse.ArgumentParser(prog="squad-board", description="Live board of the squad.")
    parser.add_argument("--replay", metavar="DIR", help="read this squad folder (required for now)")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help="0 lets the OS pick")
    parser.add_argument("--now", metavar="ISO", help="fixed time for replay, e.g. 2026-10-12T12:00:00Z")
    args = parser.parse_args(argv)
    if args.replay is None:
        return die("--replay DIR is required: live mode arrives in iteration 2", 2)
    if not Path(args.replay).is_dir():
        return die("not a directory: %s" % args.replay, 2)
    if args.now is not None and parse_ts(args.now) is None:
        return die("--now must be an ISO time with a zone, e.g. 2026-10-12T12:00:00Z", 2)
    if not 0 <= args.port <= 65535:
        return die("--port must be 0..65535", 2)
    try:
        server = make_server(args.replay, args.now, args.port)
    except OSError as e:
        if e.errno == errno.EADDRINUSE and args.port:
            return die("ports %d..%d are all busy" % (args.port, min(args.port + PORT_TRIES, 65535)), 1)
        return die("cannot bind port %d: %s" % (args.port, e.strerror), 1)
    print("squad-board: http://127.0.0.1:%d/?token=%s" % (server.server_address[1], server.token), flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
