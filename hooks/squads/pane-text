#!/usr/bin/env python3
"""Print the /squads pane as text, as the mod draws it, for a squad-tree JSON file at ROWS x COLS.

  hooks/squads/pane-text FILE ROWS COLS [--press KEY[,KEY...]] [--filter TEXT] [--then FILE2]
                                 [--loading] [--copy-fails] [--refresh-error MSG] [--styles]
  squad-tree --json | hooks/squads/pane-text - 11 60          (FILE - reads stdin)
  hooks/squads/pane-text --sync-fixtures                      (rewrites hooks/squads/fixtures.ts from the JSON files)

FILE: hooks/squads/fixtures/tree.json, tree-empty.json, real.json, or any `squad-tree --json` output.
Keys (what a person presses): refresh (r), filter-open (f), back (b, and Esc in a detail), above / below (the
`↑ N above` / `↓ N more` lines), a row key such as `plugin/goal:g1` (press a row), `plugin/done` (open the Done
group), `plugin/goal:g1:fold` (fold or unfold a goal; a group row key such as `plugin/nogoal` or `plugin/done` toggles it),
and in a detail the command's key: `cN:<id>:head` where N is its place in the list (a goal or scope detail starts with
Resume as c0, so Board is c1:board:head; a squad detail has Board as c0): it copies it and the footer shows `copied: ...`.
Order of work: first the keys of --press, then --filter (types TEXT in the filter box), then --then, then the drawing.
--then FILE2: after the keys, refresh once with FILE2 as the new data (a number changes, folds stay).
--styles: print each run's style next to its text, as `‹warning bold: needs 2›` (no width cut).
--loading: draw the first read before any data arrives ("Reading .claude/squads ..."); FILE is ignored.
--copy-fails: the clipboard refuses, so the footer says the copy failed. --refresh-error: the next refresh fails with MSG,
then `refresh` is pressed once: the last good list stays and one error line shows.
It runs the real mod in a temporary copy of the plugin through `claude plugin test`; nothing in the repo changes.
"""
import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
FIX = ROOT / "hooks" / "squads" / "fixtures"

TEMPLATE = r"""
import { test } from 'claude-code/testing'
import { boot, KEYS, pane } from './testkit'
import { dumpStyled, dumpText } from './textdump'

const TREE = %(tree)s
const OPTS = %(opts)s

test('render', async ($, on) => {
  const w = await boot($, on, TREE)
  if (!OPTS.loading) {
    await $.command.run({ command: 'squads', args: '' })
    await w.clock.settle()
  }
  w.copied = !OPTS.copyFails
  const ui = await $.ui.mount(pane('terminal', OPTS.cols, OPTS.rows))
  const press = (key: string) => $.ui.press({ ...KEYS, key, surface: 'terminal' })
  if (OPTS.refreshError) {
    w.reply = { exitCode: 1, stdout: '', stderr: OPTS.refreshError }
    await press('refresh')
  }
  for (const key of OPTS.press) await press(key)
  if (OPTS.filter) {
    if (!OPTS.press.includes('filter-open')) await press('filter-open')
    await ui.input({ key: 'filter', text: OPTS.filter, kind: 'change' })
  }
  if (OPTS.then) {
    w.reply = { exitCode: 0, stdout: OPTS.then, stderr: '' }
    await press('refresh')
  }
  const out = OPTS.styles ? dumpStyled(await ui.drawn()) : dumpText(await ui.drawn(), OPTS.cols)
  console.log('<<<PANE\n' + out + '\nPANE>>>')
})
"""


def sync_fixtures():
    parts = ["// Generated by `hooks/squads/pane-text --sync-fixtures` from fixtures/*.json: a test file cannot read a JSON file.\n"]
    for name, const in (("tree", "TREE"), ("tree-empty", "EMPTY")):
        parts.append("export const %s = %s\n" % (const, json.dumps(json.loads((FIX / (name + ".json")).read_text(encoding="utf-8")), indent=1, ensure_ascii=False)))
    (ROOT / "hooks" / "squads" / "fixtures.ts").write_text("\n".join(parts), encoding="utf-8")


def main(argv):
    if argv[:1] == ["--sync-fixtures"]:
        sync_fixtures()
        return 0
    if len(argv) < 3 or not argv[1].isdigit() or not argv[2].isdigit():
        print(__doc__, file=sys.stderr)
        return 2
    src, rows, cols = argv[0], int(argv[1]), int(argv[2])
    opts = {"rows": rows, "cols": cols, "press": [], "filter": "", "then": "", "loading": False, "copyFails": False, "refreshError": "", "styles": False}
    rest = argv[3:]
    while rest:
        a = rest.pop(0)
        if a == "--press" and rest:
            opts["press"] = [k for k in rest.pop(0).split(",") if k]
        elif a == "--filter" and rest:
            opts["filter"] = rest.pop(0)
        elif a == "--then" and rest:
            opts["then"] = Path(rest.pop(0)).read_text(encoding="utf-8")
        elif a == "--loading":
            opts["loading"] = True
        elif a == "--refresh-error" and rest:
            opts["refreshError"] = rest.pop(0)
        elif a == "--styles":
            opts["styles"] = True
        elif a == "--copy-fails":
            opts["copyFails"] = True
        else:
            print("unknown argument: " + a, file=sys.stderr)
            return 2
    text = sys.stdin.read() if src == "-" else Path(src).read_text(encoding="utf-8")
    try:
        json.loads(text)  # refuse a file that is not JSON before anything runs
    except ValueError as e:
        if not opts["loading"]:
            print("not JSON: %s" % e, file=sys.stderr)
            return 2
        text = "{}"  # the loading state never reads the data
    tmp = Path(tempfile.mkdtemp())
    try:
        for d in ("hooks", "types", ".claude-plugin"):
            shutil.copytree(ROOT / d, tmp / d, ignore=shutil.ignore_patterns("*.test.*", "fixtures", "__pycache__"))
        (tmp / "hooks" / "squads" / "render.test.tsx").write_text(
            TEMPLATE % {"tree": json.dumps(text), "opts": json.dumps(opts)}, encoding="utf-8")
        done = subprocess.run(["claude", "plugin", "test", str(tmp)], cwd=str(tmp), stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, timeout=300)
        out = done.stdout.decode("utf-8", "replace")
        m = re.search(r"<<<PANE\n(.*?)\nPANE>>>", out, re.S)
        if not m:
            print(out, file=sys.stderr)
            return 1
        body = m.group(1)
        print("rows=%d cols=%d lines=%d" % (rows, cols, len(body.split("\n"))))
        print(body)
        return 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
