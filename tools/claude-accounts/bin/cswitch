#!/usr/bin/env bash
# cswitch 1|2|3 [pane-id] -> once the Claude agent in a Herdr pane (default: this
# pane) is idle, /exit it and resume the same session on the given account,
# keeping its original launch args (--agent, --settings, --model, ...) and herdr name.
. "$HOME/.claude-accounts/lib.sh"
# Git Bash: no /proc or pgrep (caproc.py asks herdr instead), and it rewrites path-like args for native exes:
# "/exit" would reach herdr.exe as "C:/Program Files/Git/exit", "w1:p2" as a path list.
# That also stops conversion for python3.exe, so caproc.py gets a C:/... path here.
CAPROC="$HOME/.claude-accounts/bin/caproc.py"
if [ "$CA_WIN" = 1 ]; then export MSYS2_ARG_CONV_EXCL="*"; CAPROC=$(cygpath -m "$CAPROC"); fi
export CA_WIN CAPROC
acct="${1:-}"; pane="${2:-${HERDR_PANE_ID:-}}"
case "$acct" in 1|2|3) launcher="c$acct" ;; *) echo "usage: cswitch 1|2|3 [pane]" >&2; exit 2 ;; esac
[ "${HERDR_ENV:-}" = 1 ] || { echo "not inside Herdr" >&2; exit 1; }
info=$(herdr pane get "$pane" 2>/dev/null)
sid=$(jq -er '.result.pane.agent_session.value' <<<"$info") \
  || { echo "no Claude session found in pane $pane" >&2; exit 1; }
name=$(herdr agent list | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id==$p) | .name // empty')
sid=${sid//$'\r'/}; name=${name//$'\r'/}  # a Windows jq may end its lines with CRLF

# Busy check (also run in the watcher): sets st (agent status) and bg (.tokens.bg: "⏵ 1 shell", "⏵ 1 monitor").
# Background work never ends by itself and /exit would stop it (a shell can look idle/done to herdr); a blocked pane
# is in a permission dialog. A failed lookup is "not busy": cswitch then works as before.
probe() {
  local j; j=$(herdr agent get "$pane" 2>/dev/null) || return 1
  st=$(jq -r '.result.agent.agent_status // empty' <<<"$j" 2>/dev/null); bg=$(jq -r '.result.agent.tokens.bg // empty' <<<"$j" 2>/dev/null)
  st=${st//$'\r'/}; bg=${bg//$'\r'/}
}
busy() { probe && { [ -n "$bg" ] || [ "$st" = blocked ]; }; }
# The one result line; exit 75 (EX_TEMPFAIL) tells cautoswitch to back off, not to retry at once.
skip() { st=; bg=; probe; echo "$(date -Is) $pane skipped: busy (${st:-?}, ${bg:--})"; exit 75; }
if busy; then
  line=$(skip)  # skip exits 75 in the subshell
  echo "$line" >>"$ACCT_HOME/cswitch.log"; echo "$line"; exit 75
fi

# The pane's claude process carries the original args; find it by its HERDR_PANE_ID.
# Skip "claude daemon run" children (argv[1]=daemon); other users' processes are unreadable, so ask for ours only.
tuipid() {
  local p a1
  if [ "$CA_WIN" = 1 ]; then python3 "$CAPROC" pane-pid "$pane" 2>/dev/null; return; fi
  for p in $(pgrep -u "$(id -u)" -x claude); do
    a1=$({ tr '\0' '\n' <"/proc/$p/cmdline" | sed -n 2p; } 2>/dev/null)
    [ "$a1" = daemon ] && continue
    { tr '\0' '\n' <"/proc/$p/environ" | grep -qx "HERDR_PANE_ID=$pane"; } 2>/dev/null && { echo "$p"; return 0; }
  done
  return 1
}
pid=$(tuipid)
# Without /proc a failed lookup looks like "claude is gone"; the watcher below would then type into the live session.
[ "$CA_WIN" = 1 ] && [ -z "$pid" ] && { echo "no claude process found in pane $pane (is python3 on PATH?)" >&2; exit 1; }
args=()
if [ -n "$pid" ]; then
  if [ "$CA_WIN" = 1 ]; then mapfile -d '' -t old < <(python3 "$CAPROC" argv "$pane")
  else mapfile -d '' -t old < "/proc/$pid/cmdline"; fi
  # Drop argv[0], any earlier resume/continue and --session-id (claude rejects it with --resume) so the session resumes exactly once.
  i=1
  while [ $i -lt ${#old[@]} ]; do
    case "${old[$i]}" in
      --resume|-r) i=$((i+2)); continue ;;
      --resume=*|--continue|-c|--session-id=*) i=$((i+1)); continue ;;
      --session-id) i=$((i+2)); continue ;;
    esac
    args+=("${old[$i]}"); i=$((i+1))
  done
fi
shell=; [ "$CA_WIN" = 1 ] && shell=$(python3 "$CAPROC" shell "$pane" 2>/dev/null | tr -d '\r')
if [ "$CA_WIN" = 1 ] && [ "$shell" != bash ]; then
  # A PowerShell pane has the launchers as profile functions, so the bare name works there; a /c/... path would not.
  # (A non-login bash pane has no PATH entry for them, so bash gets the full path below.) PowerShell writes ' as ''.
  cmd="$launcher"; for a in "${args[@]}"; do cmd+=" '${a//\'/\'\'}'"; done; cmd+=" --resume $sid"
else
  cmd=$(printf '%q ' "$HOME/.claude-accounts/bin/$launcher" "${args[@]}" --resume "$sid")
fi

# Detached: when called from the agent being switched, its own exit must not kill this.
nohup bash -c '
  pane=$0 cmd=$1 name=$2
  eval "$3"  # probe, busy, skip
  # idle or done only, so /exit never lands in a permission dialog. A timeout (blocked, or a subagent keeps it working) is a skip.
  herdr agent wait "$pane" --until idle --until done --timeout "${CSWITCH_WAIT_MS:-600000}" >/dev/null || skip
  # Background work started meanwhile: the wait result alone does not show a shell or monitor.
  busy && skip
  # Pending-work sample (clauses 1 and 3) while the pane is quiet and still on the old account; no-op when CSWITCH_WAKE=off.
  [ "${CSWITCH_WAKE:-on}" = off ] || "$HOME/.claude-accounts/bin/cwake" --mark "$pane" --clauses 13 >/dev/null 2>&1
  # herdr can drop "agent" before claude has exited; typing then loses the command, so watch the process itself.
  tuipid() { if [ "$CA_WIN" = 1 ]; then python3 "$CAPROC" pane-pid "$pane" 2>/dev/null; return; fi; for p in $(pgrep -u "$(id -u)" -x claude); do a1=$({ tr "\0" "\n" <"/proc/$p/cmdline" | sed -n 2p; } 2>/dev/null); [ "$a1" = daemon ] && continue; { tr "\0" "\n" <"/proc/$p/environ" | grep -qx "HERDR_PANE_ID=$pane"; } 2>/dev/null && { echo "$p"; return 0; }; done; return 1; }
  alive() { tuipid >/dev/null; }
  # agent_blocked (a dialog opened since the check): /exit was never typed.
  herdr agent prompt "$pane" "/exit" >/dev/null || skip
  for i in $(seq 240); do
    alive || break
    # "Background work is running": Escape = "Stay". Never 1 or 2 (they stop the work or detach the session).
    if herdr pane read "$pane" --source visible --lines 14 2>/dev/null | grep -q "Background work is running"; then
      herdr pane send-keys "$pane" Escape >/dev/null
      skip
    fi
    sleep 0.5
  done
  alive && { echo "$(date -Is) $pane FAILED: claude did not exit"; exit 1; }
  sleep 1
  ok=""
  for try in 1 2; do
    herdr pane run "$pane" "$cmd"
    pid1=""
    for i in $(seq 60); do pid1=$(tuipid) && break; sleep 0.5; done
    [ -n "$pid1" ] || continue
    # Up is not enough: a bad launch shows claude for a moment, then it exits.
    sleep 5
    [ "$(tuipid)" = "$pid1" ] || continue
    for i in $(seq 60); do herdr pane get "$pane" | grep -q "\"agent\":\"claude\"" && { ok=1; break; }; sleep 0.5; done
    break  # claude is up and stable: a retry would type the command into it
  done
  [ -n "$ok" ] || { echo "$(date -Is) $pane FAILED: claude did not restart"; exit 1; }
  if [ -n "$name" ]; then
    for i in $(seq 60); do herdr pane get "$pane" | grep -q "\"agent\":\"claude\"" && break; sleep 0.5; done
    herdr agent rename "$pane" "$name" >/dev/null
  fi
  echo "$(date -Is) $pane ${name:-?} done"
' "$pane" "$cmd" "$name" "$(declare -f probe busy skip)" >>"$ACCT_HOME/cswitch.log" 2>&1 &
echo "$(date -Is) $pane ${name:-?} -> account $acct: $cmd" >>"$ACCT_HOME/cswitch.log"
echo "will resume session $sid on account $acct in pane $pane once idle"
