#!/usr/bin/env python3
"""cautoswitch [--threshold 90] [--interval 300] [--once] [--dry-run]

Every interval, for each herdr workspace that has a squad agent (a Claude pane whose
process carries SQUAD_NAME): when its default account's 5-hour usage reaches the
threshold and another account is lower on both 5h and 7d, make that account the
workspace's default (never the global one), then cswitch every squad agent of the
workspace that runs off its default, one after the other. It waits SHORT_WAIT for each
pane's result and moves on (at most MAX_INFLIGHT switches run at once); a pane whose cswitch
`skipped:` or FAILED is retried after 2, 4, 8 ... (at most BACKOFF_CAP) ticks. Each cswitch it starts waits
SWITCH_WAIT_MS (2 min) for its pane to go idle (env CSWITCH_WAIT_MS on the call); a pane that stays `working`
(a subagent) is then skipped and frees its slot. A manual cswitch keeps its own 10 min wait. Run it in its own herdr tab.
Usage: cautoswitch --interval 300 in a dedicated tab; it retries off-default panes every tick.
"""
import argparse, datetime, json, os, subprocess, sys, time, urllib.request
from pathlib import Path

H = os.path.expanduser("~/.claude-accounts")
CFG = {"1": os.path.expanduser("~/.claude"), "2": os.path.expanduser("~/.claude-2"), "3": os.path.expanduser("~/.claude-3")}
CACHE_MAX_AGE = 900  # status-line cache older than this is too stale to act on
if os.name == "nt":  # Git Bash: no /proc, no pgrep, no exec of extensionless scripts; caproc.py stands in
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import caproc
    norm = caproc.norm_path
else:
    norm = os.path.normpath
ACCT_OF = {norm(v): k for k, v in CFG.items()}
REFRESH_FAILED = {}  # acct -> time of the last failed claude -p refresh
PENDING_DIR = f"{H}/wake-pending"
MARKER_MAX_AGE = 1800  # a wake marker older than this is deleted unsent
OLD_ACCT = {}  # pane -> account it ran on before its last cswitch (for the wake text)
SHORT_WAIT = 60  # s the loop waits for one pane's result before it moves on (the pane stays pending)
POLL = 5  # s between two looks at cswitch.log inside that wait
SWITCH_WAIT_MS = 120000  # ms a cswitch started here waits for its pane to go idle (a manual cswitch waits 600000) before it skips the pane
MAX_INFLIGHT = 2  # switches running at once (sessions must not all restart together)
BACKOFF_CAP = 10  # a pane that skipped or FAILED is retried after 2, 4, 8 ... but at most this many ticks
# In-memory state (a restart of cautoswitch forgets it: every pane is tried again at once, which is safe).
TICKNO = 0
BACKOFF = {}  # pane -> [consecutive skipped/FAILED results, first tick it may be tried again]
INFLIGHT = {}  # pane -> (byte offset of cswitch.log when its cswitch started, name): result not seen yet


def log(msg):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S')} autoswitch: {msg}"
    print(line, flush=True)
    with open(f"{H}/cswitch.log", "a", encoding="utf-8") as f:
        f.write(line + "\n")


def run_bin(name, *args, **kw):
    """Run ~/.claude-accounts/bin/<name>. Windows cannot exec an extensionless script: pick the interpreter by its shebang."""
    cmd = [f"{H}/bin/{name}", *args]
    if os.name == "nt":
        with open(cmd[0], encoding="utf-8") as f:
            python = "python" in f.readline()
        prog = sys.executable if python else caproc.bash_exe()
        if not prog:
            raise RuntimeError("Git Bash not found (set CA_BASH)")
        cmd = [prog, Path(cmd[0]).as_posix(), *args]
    return subprocess.run(cmd, **kw)


def read_creds(acct):
    return json.load(open(f"{CFG[acct]}/.credentials.json"))["claudeAiOauth"]


def refresh_token(acct):
    """An expired access token is renewed by Claude Code itself: one tiny claude -p under that account."""
    if time.time() - REFRESH_FAILED.get(acct, 0) < 1800:
        return
    env = {**os.environ, "ACCT_NO_WS_DEFAULT": "1"}  # a refresh must not become a workspace default
    try:
        rc = run_bin(f"c{acct}", "-p", "ok", "--model", "haiku", "--no-session-persistence",
                     env=env, cwd=H, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, timeout=60).returncode
    except Exception as e:
        rc = type(e).__name__
    try:
        ok = read_creds(acct).get("expiresAt", 0) / 1000 > time.time() + 60
    except Exception:
        ok = False
    if ok:
        log(f"c{acct} token expired; refreshed via claude -p")
    else:
        REFRESH_FAILED[acct] = time.time()
        log(f"c{acct} token still expired after claude -p (rc={rc})")


def usage(acct):
    """(five_pct, week_pct) from the live usage endpoint, else a fresh cache, else None."""
    try:
        c = read_creds(acct)
        if c.get("expiresAt", 0) / 1000 <= time.time() + 60:
            refresh_token(acct)
            c = read_creds(acct)
        if c.get("expiresAt", 0) / 1000 > time.time():
            req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
                "Authorization": "Bearer " + c["accessToken"], "anthropic-beta": "oauth-2025-04-20"})
            d = json.loads(urllib.request.urlopen(req, timeout=8).read())
            return d["five_hour"]["utilization"], d["seven_day"]["utilization"]
    except Exception:
        pass
    try:
        f5, _, f7, _, at = open(f"{H}/usage-{acct}").read().split()
        if time.time() - float(at) < CACHE_MAX_AGE:
            return float(f5), float(f7)
    except (OSError, ValueError):
        pass
    return None


def claude_envs():
    """The environment of every running claude TUI."""
    if os.name == "nt":
        return caproc.pane_envs()
    out = []
    for pid in subprocess.run(["pgrep", "-x", "claude"], capture_output=True, text=True).stdout.split():
        try:
            env = dict(kv.split("=", 1) for kv in open(f"/proc/{pid}/environ").read().split("\0") if "=" in kv)
            # the "claude daemon run" child shares the pane's env but can keep the old account after a cswitch
            if open(f"/proc/{pid}/cmdline").read().split("\0")[1:2] == ["daemon"]:
                continue
        except OSError:
            continue
        out.append(env)
    return out


def squad_panes():
    """{pane_id: (squad_name, account, workspace)} for every running claude process with SQUAD_NAME."""
    out = {}
    for env in claude_envs():
        acct = ACCT_OF.get(norm(env.get("CLAUDE_CONFIG_DIR") or CFG["1"]))
        if env.get("SQUAD_NAME") and env.get("HERDR_PANE_ID") and env.get("HERDR_WORKSPACE_ID") and acct:
            out[env["HERDR_PANE_ID"]] = (env["SQUAD_NAME"], acct, env["HERDR_WORKSPACE_ID"])
    return out


def workspace_default(ws):
    """cdefault is the one source of truth for the file format and the global fallback."""
    r = run_bin("cdefault", capture_output=True, text=True,
                env={**os.environ, "HERDR_ENV": "1", "HERDR_WORKSPACE_ID": ws})
    return r.stdout.strip() if r.stdout.strip() in CFG else "1"


def pending(pane):
    """True when the pane's last cswitch.log line is a '-> account' line younger than 15 min."""
    last = ""
    try:
        with open(f"{H}/cswitch.log", encoding="utf-8") as f:
            for l in f:
                w = l.split()
                if len(w) > 1 and w[1] == pane:
                    last = l
    except OSError:
        return False
    if " -> account " not in last:
        return False
    try:
        return time.time() - datetime.datetime.fromisoformat(last.split()[0]).timestamp() < 900
    except ValueError:
        return False


def result_since(pane, start):
    """(kind, line) of the pane's last result line in cswitch.log after byte offset `start`, else None.
    kind: done | fail (FAILED) | skip (` skipped:`, cswitch exit 75)."""
    res = None
    try:
        with open(f"{H}/cswitch.log", encoding="utf-8") as f:
            f.seek(start)
            for l in f:
                if len(w := l.split()) < 2 or w[1] != pane:
                    continue
                if "FAILED" in l:
                    res = ("fail", l)
                elif " skipped:" in l:
                    res = ("skip", l)
                elif " done" in l:
                    res = ("done", l)
    except OSError:
        pass
    return res


def settle(pane, name, kind, line):
    """A switch ended. done resets the pane's backoff; skip or fail doubles it (2, 4, 8 ... BACKOFF_CAP ticks) and logs why."""
    INFLIGHT.pop(pane, None)
    if kind == "done":
        BACKOFF.pop(pane, None)
        return
    fails = BACKOFF.get(pane, [0, 0])[0] + 1
    delay = min(2 ** min(fails, 10), BACKOFF_CAP)
    BACKOFF[pane] = [fails, TICKNO + delay]
    why = (line.split(None, 2) + ["", ""])[2].strip()
    log(f"backoff: {name}({pane}) {why}; miss {fails}, next try in {delay} ticks (tick {TICKNO + delay})")


def collect():
    """Results that came after the wait window (a skipped or FAILED line of an earlier tick) feed the backoff."""
    for pane, (start, name) in list(INFLIGHT.items()):
        r = result_since(pane, start)
        if r:
            settle(pane, name, *r)
        elif not pending(pane):
            INFLIGHT.pop(pane)  # no result and not pending any more (15 min): give up watching


def log_ts(line):
    """Epoch of a cswitch.log line (the leading `date -Is` stamp), else None."""
    try:
        return datetime.datetime.fromisoformat(line.split()[0]).timestamp()
    except (ValueError, IndexError):
        return None


def marker_file(pane):
    """wake-pending/<pane>; on Windows w1:p2 is stored as w1_p2 (a file name cannot hold a colon)."""
    return f"{PENDING_DIR}/{pane.replace(':', '_') if os.name == 'nt' else pane}"


def markers():
    """{pane: (epoch, name, reason)} of wake-pending/."""
    out = {}
    try:
        files = os.listdir(PENDING_DIR)
    except OSError:
        return out
    for fname in files:
        if fname.startswith("."):
            continue
        pane = fname.replace("_", ":") if os.name == "nt" else fname
        try:
            with open(marker_file(pane), encoding="utf-8") as f:
                e, name, reason = (f.read().split(None, 2) + [""])[:3]
            out[pane] = (int(e), name, reason.strip())
        except (OSError, ValueError):
            pass
    return out


def batch_start(panes):
    """Epoch of the first '-> account' line of these panes in the last 30 min (T0 of the batch), else None."""
    t0 = None
    try:
        with open(f"{H}/cswitch.log", encoding="utf-8") as f:
            for l in f:
                w = l.split()
                if len(w) > 1 and w[1] in panes and " -> account " in l:
                    t = log_ts(l)
                    if t and time.time() - t < MARKER_MAX_AGE and (t0 is None or t < t0):
                        t0 = t
    except OSError:
        pass
    return t0


def woken_since(pane, t0):
    """True when cswitch.log has a 'wake sent|skipped' line of the pane at or after t0."""
    try:
        with open(f"{H}/cswitch.log", encoding="utf-8") as f:
            for l in f:
                w = l.split()
                if len(w) > 3 and w[1] == pane and w[-2] == "wake" and w[-1] in ("sent", "skipped") \
                        and (log_ts(l) or 0) >= t0:
                    return True
    except OSError:
        pass
    return False


def wake_step(panes, target, back):
    """After the per-pane loop: expire old markers, then wake each marked pane that is back on its workspace's
    default, once its workspace has no cswitch in flight. `back` = panes known to be on target.
    A pane that failed or is still running keeps its marker and is not woken (the others are not held up)."""
    for pane, (epoch, name, _) in markers().items():
        if time.time() - epoch > MARKER_MAX_AGE:
            os.remove(marker_file(pane))
            log(f"wake marker of {name}({pane}) older than 30 min; deleted unsent")
    gap = float(os.environ.get("CSWITCH_WAKE_GAP", "3"))
    for ws in target:
        wp = {p for p, v in panes.items() if v[2] == ws}
        if any(pending(p) for p in wp):
            continue  # a cswitch of this workspace is still within its 15 min: wake next tick
        t0 = batch_start(wp)
        if t0 is not None:
            for p in sorted(wp & back):
                if not woken_since(p, t0):
                    run_bin("cwake", "--mark", p, "--clauses", "2", "--since", str(t0))
        due = sorted((m[p][0], p) for m in [markers()] for p in m if p in wp and p in back)
        for i, (_, p) in enumerate(due):
            if i:
                time.sleep(gap)
            old = OLD_ACCT.get(p)
            run_bin("cwake", p, *(["--old", old, "--new", target[ws]] if old else []))


def tick(threshold, dry):
    global TICKNO
    TICKNO += 1
    panes = squad_panes()
    target = {ws: workspace_default(ws) for ws in sorted({p[2] for p in panes.values()})}
    seen = {}

    def use(acct):  # at most one fetch (so one refresh attempt) per account per tick
        if acct not in seen:
            seen[acct] = usage(acct)
        return seen[acct]

    fmt = lambda u: f"5h {u[0]:.0f}% 7d {u[1]:.0f}%" if u else "n/a"
    status = []
    for ws in target:
        t = target[ws]
        ut = use(t)
        status.append(f"{ws} -> c{t} {fmt(ut)}")
        if ut is None or ut[0] < threshold:
            continue
        better = {o: use(o) for o in CFG if o != t}
        better = {o: u for o, u in better.items() if u and u[0] < ut[0] and u[1] < ut[1]}
        if not better:
            log(f"{ws} c{t} over {threshold}% but no other account is lower on both; staying. c{t} {fmt(ut)}")
            continue
        other = min(better, key=lambda o: better[o][0])
        log(f"{'[dry-run] would set' if dry else 'setting'} {ws} default to c{other}: c{t} {fmt(ut)}; c{other} {fmt(better[other])}")
        if not dry:
            run_bin("cdefault", "--ws", ws, other, check=True)
            target[ws] = other
    print(f"{time.strftime('%H:%M:%S')} ok: {' | '.join(status) or 'no squad panes'}", flush=True)
    wake_on = os.environ.get("CSWITCH_WAKE", "on") != "off"
    back = {p for p, (_, acct, ws) in panes.items() if acct == target[ws] and not pending(p)}
    # Not all at once, or messages between agents fail. Each pane gets SHORT_WAIT; a pane without a result stays pending
    # (see pending()) and the loop moves on, with MAX_INFLIGHT switches running at most.
    if not dry:
        collect()
    for pane, (name, acct, ws) in panes.items():
        if acct == target[ws]:
            continue
        if dry:
            log(f"[dry-run] would cswitch {name}({pane}) c{acct} -> c{target[ws]}")
            continue
        if pending(pane) or BACKOFF.get(pane, [0, 0])[1] > TICKNO:
            continue
        if sum(pending(p) for p in set(panes) | set(INFLIGHT)) >= MAX_INFLIGHT:  # a pane between /exit and relaunch has no claude process
            log(f"deferred: cswitch {name}({pane}); {MAX_INFLIGHT} switches already in flight")
            continue
        log(f"retry: cswitch {name}({pane}) c{acct} -> c{target[ws]}")
        start = os.path.getsize(f"{H}/cswitch.log")
        OLD_ACCT[pane] = acct
        INFLIGHT[pane] = (start, name)
        run_bin("cswitch", target[ws], pane, env=dict(os.environ, CSWITCH_WAIT_MS=str(SWITCH_WAIT_MS)))
        deadline = time.time() + SHORT_WAIT
        while True:
            r = result_since(pane, start)
            if r:
                settle(pane, name, *r)
                if r[0] == "done":
                    back.add(pane)
                break
            if time.time() >= deadline:
                break
            time.sleep(POLL)
    if wake_on and not dry:
        wake_step(panes, target, back)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--threshold", type=float, default=90)
    ap.add_argument("--interval", type=int, default=300)
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    if os.environ.get("HERDR_ENV") != "1":
        sys.exit("not inside Herdr")
    while True:
        try:
            tick(a.threshold, a.dry_run)
        except Exception as e:  # one bad tick must not stop the watcher
            log(f"error: {e}")
        if a.once:
            return
        time.sleep(a.interval)


if __name__ == "__main__":
    main()
