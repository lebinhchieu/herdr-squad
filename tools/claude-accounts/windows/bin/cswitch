#!/usr/bin/env bash
# cswitch 1|2|3 [pane-id] [-- extra claude args]  -> exit the Claude agent in a Herdr
# pane (default: this pane) once it is idle, then resume the same session on the
# given account. Extra args (e.g. --agent/--settings/--model) are re-applied on resume.
. "$HOME/.claude-accounts/lib.sh"
# Git Bash rewrites path-like args for native exes: "/exit" would reach herdr.exe as
# "C:/Program Files/Git/exit".
export MSYS2_ARG_CONV_EXCL="*"
acct="$1"; shift
case "$acct" in 1|2|3) ;; *) echo "usage: cswitch 1|2|3 [pane] [-- claude args]" >&2; exit 2 ;; esac
pane="$HERDR_PANE_ID"
if [ $# -gt 0 ] && [ "$1" != "--" ]; then pane="$1"; shift; fi
[ "${1:-}" = "--" ] && shift
extra=""; for a in "$@"; do extra+=" '${a//\'/\'\'}'"; done
[ "${HERDR_ENV:-}" = 1 ] || { echo "not inside Herdr" >&2; exit 1; }
sid=$(herdr pane get "$pane" 2>/dev/null | python -c 'import sys,json; p=json.load(sys.stdin)["result"]["pane"]; print(p["agent_session"]["value"])') \
  || { echo "no Claude session found in pane $pane" >&2; exit 1; }
# Bare "c1"/"c2" resolves in both pane shells: a bash function/PATH entry, or the
# PowerShell profile function (a /c/... path would fail in PowerShell).
cmd="c$acct --resume $sid$extra"
# Detached: when called from the agent being switched, its own exit must not kill this.
nohup bash -c '
  herdr agent wait "$0" --timeout 600000 >/dev/null
  herdr agent prompt "$0" "/exit" >/dev/null
  for i in $(seq 60); do herdr pane get "$0" | grep -q "\"agent\":\"claude\"" || break; sleep 0.5; done
  sleep 2
  herdr pane run "$0" "$1"
' "$pane" "$cmd" >"$ACCT_HOME/cswitch.log" 2>&1 &
echo "will run '$cmd' in pane $pane once idle"
