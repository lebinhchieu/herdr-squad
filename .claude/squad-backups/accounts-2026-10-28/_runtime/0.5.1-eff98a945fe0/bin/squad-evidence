#!/usr/bin/env python3
"""One evidence.md per ticket, screenshots embedded in place. No LLM, no network.

  squad-evidence path <ticket.md>
  squad-evidence add <ticket.md> --heading H --from review.md [--root DIR] [--sha SHA]
  squad-evidence check <evidence.md|folder> [--base SHA]

Exit 0 ok, 1 problems found, 2 usage error.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import squadio  # noqa: E402


def main(argv=None):
    squadio.utf8_stdio()
    argv = list(sys.argv[1:] if argv is None else argv)
    import squadevidence
    return squadevidence.run(argv)


if __name__ == "__main__":
    sys.exit(main())
